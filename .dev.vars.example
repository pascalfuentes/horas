# Copy to `.dev.vars` (stays out of Git) before running `npm run dev`.

# Required. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="troque-isto-openssl-rand-base64-32"

# Base URL of the application. In dev it is the Astro server.
BETTER_AUTH_URL="http://localhost:4321"

# Used a SINGLE time, in /setup, to create the first admin.
# Once a user exists, /setup stops working forever.
SETUP_SECRET="troque-isto-tambem"

# E-mail. Without RESEND_API_KEY, e-mails are printed to the console,
# which is enough to test invitations and password reset locally.
RESEND_API_KEY=""
EMAIL_FROM="Horas <no-reply@exemplo.com>"

# Cloudflare Turnstile (optional). Without the keys, the widget is skipped.
PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
