---
import BusyForms from "~/components/BusyForms.astro";
import Theme from "~/components/Theme.astro";
import Alert from "~/components/Alert.astro";
import PendingInvites from "~/components/PendingInvites.astro";
import { APP_NAME } from "~/config";
import { pendingInvitesFor } from "~/lib/members";
import { ROLE_LABELS, canAdministerPlatform, can, PERMISSIONS } from "~/lib/permissions";
import { userWorkspaces } from "~/lib/workspaces";
import "~/styles/global.css";

interface Props {
  title: string;
  heading: string;
  description?: string;
}

const { title, heading, description } = Astro.props;
const user = Astro.locals.user!;
const current = Astro.locals.membership;
const superadmin = canAdministerPlatform(user.role);
const path = Astro.url.pathname;
const params = Astro.url.searchParams;

// For the switcher. One query per rendered page is cheap and keeps the list
// from going stale after creating or leaving a workspace.
const myWorkspaces = await userWorkspaces(Astro.locals.env, user.id);

// An invite used to exist only in the email link. Whoever deleted the message
// had no way in at all, even while logged in — hence the notice at the top of
// the dashboard. On `/workspaces` it is omitted because the full list is already
// shown there.
const showInvites = path !== "/workspaces";
const pendingInvites = showInvites
  ? await pendingInvitesFor(Astro.locals.env, user.email)
  : [];

// One line icon per destination (24px grid, drawn with the text colour), so a
// page can be found by shape before reading its name.
const ICONS: Record<string, string> = {
  time: "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 7v5l3 2",
  reports: "M3 20h18M6 20v-8M12 20V5M18 20v-5",
  projects: "M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z",
  data: "M7 20V5M7 5 3.5 8.5M7 5l3.5 3.5M17 4v15M17 19l-3.5-3.5M17 19l3.5-3.5",
  integrations: "M8 8l-4 4 4 4M16 8l4 4-4 4M13.5 5l-3 14",
  members: "M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zM2.5 20a6.5 6.5 0 0 1 13 0M16 4.3a3.5 3.5 0 0 1 0 6.4M18.5 14.6a6.5 6.5 0 0 1 3 5.4",
  settings: "M4 7h10M18 7h2M4 17h2M10 17h10M14 7a2 2 0 1 0 4 0 2 2 0 0 0-4 0zM6 17a2 2 0 1 0 4 0 2 2 0 0 0-4 0z",
  profile: "M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4.5 20a7.5 7.5 0 0 1 15 0",
  security: "M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6zM9 12l2 2 4-4",
  users: "M4 5h16v14H4zM9.5 11.5a1.75 1.75 0 1 0 0-3.5 1.75 1.75 0 0 0 0 3.5zM6.5 16a3 3 0 0 1 6 0M15 10h3M15 14h3",
  audit: "M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01",
};

const groups = [
  ...(current
    ? [
        {
          group: current.workspaceName,
          items: [
            ...(can(current.role, PERMISSIONS.CONTENT_READ)
              ? [
                  { href: `/w/${current.workspaceSlug}/time`, label: "Time", icon: "time" },
                  { href: `/w/${current.workspaceSlug}/reports`, label: "Reports", icon: "reports" },
                  { href: `/w/${current.workspaceSlug}/projects`, label: "Projects", icon: "projects" },
                  { href: `/w/${current.workspaceSlug}/data`, label: "Import & export", icon: "data" },
                  { href: `/w/${current.workspaceSlug}/integrations`, label: "API & MCP", icon: "integrations" },
                ]
              : []),
            ...(can(current.role, PERMISSIONS.MEMBERS_READ)
              ? [{ href: `/w/${current.workspaceSlug}/members`, label: "Members", icon: "members" }]
              : []),
            ...(can(current.role, PERMISSIONS.WORKSPACE_READ)
              ? [{ href: `/w/${current.workspaceSlug}/settings`, label: "Settings", icon: "settings" }]
              : []),
          ],
        },
      ]
    : []),
  {
    group: "Account",
    items: [
      { href: "/dashboard/profile", label: "My details", icon: "profile" },
      { href: "/dashboard/security", label: "Security", icon: "security" },
    ],
  },
  ...(superadmin
    ? [
        {
          group: "Platform",
          items: [
            { href: "/dashboard/admin/users", label: "Users", icon: "users" },
            { href: "/dashboard/admin/audit", label: "Audit log", icon: "audit" },
          ],
        },
      ]
    : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <Theme />
    <BusyForms />
    <script is:inline src="/app/select.js" defer></script>
  </head>
  <body>
    <div class="app">
      <nav class="sidenav" aria-label="Main navigation">
        <a class="brand" href="/dashboard"><span class="logo" aria-hidden="true"></span>{APP_NAME}</a>
        <details class="ws-picker" open={!current}>
          <summary>{current ? current.workspaceName : "Choose workspace"}</summary>
          {myWorkspaces.map((w) => (
            <a href={`/w/${w.workspaceSlug}/time`} aria-current={w.workspaceSlug === current?.workspaceSlug ? "true" : undefined}>
              {w.workspaceName}
              <small class="muted"> · {ROLE_LABELS[w.role]}</small>
            </a>
          ))}
          <a href="/workspaces">+ New workspace</a>
        </details>

        {groups.map((g) => (
          <>
            <div class="group">{g.group}</div>
            {g.items.map((item) => (
              <a href={item.href} aria-current={path === item.href || path.startsWith(item.href + "/") ? "page" : undefined}>
                <svg class="nav-ico" viewBox="0 0 24 24" aria-hidden="true"><path d={ICONS[item.icon]} /></svg>
                <span>{item.label}</span>
              </a>
            ))}
          </>
        ))}
        <button type="button" class="btn-ghost btn-sm theme-toggle" data-theme-toggle>Dark mode</button>
      </nav>

      <main class="content">
        <div class="page-head">
          <div>
            <h1>{heading}</h1>
            {description && <p class="muted">{description}</p>}
          </div>
          <div class="who">
            <span>
              {user.name}<br />
              {current
                ? <span class="badge">{ROLE_LABELS[current.role]} · {current.workspaceName}</span>
                : superadmin
                  ? <span class="badge badge-admin">Platform superadmin</span>
                  : <span class="badge">Account</span>}
            </span>
            <span class="avatar" aria-hidden="true">{user.name.trim().charAt(0).toUpperCase()}</span>
            <form method="post" action="/api/logout" class="inline-form">
              <button class="btn-ghost btn-sm" type="submit">Log out</button>
            </form>
          </div>
        </div>
        <Alert error={params.get("e")} success={params.get("ok")} />
        <PendingInvites invites={pendingInvites} verified={user.emailVerified} limit={3} />
        <slot />
      </main>
    </div>
  </body>
</html>
