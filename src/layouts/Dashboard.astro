---
import Alert from "~/components/Alert.astro";
import PendingInvites from "~/components/PendingInvites.astro";
import { APP_NAME } from "~/config";
import { pendingInvitesFor } from "~/lib/members";
import { ROLE_LABELS, canAdministerPlatform, can, PERMISSIONS } from "~/lib/permissions";
import { userWorkspaces } from "~/lib/workspaces";
import "~/styles/global.css";

interface Props {
  title: string;
  heading: string;
  description?: string;
}

const { title, heading, description } = Astro.props;
const user = Astro.locals.user!;
const atual = Astro.locals.membership;
const superadmin = canAdministerPlatform(user.role);
const path = Astro.url.pathname;
const params = Astro.url.searchParams;

// Para o seletor. Uma consulta por página renderizada é barata e evita que a
// lista fique velha depois de criar ou sair de um workspace.
const meusWorkspaces = await userWorkspaces(Astro.locals.env, user.id);

// Convite só existia no link do e-mail. Quem apagou a mensagem ficava sem
// caminho nenhum, mesmo já estando logado — daí o aviso no topo do painel.
// Em `/workspaces` ele é omitido porque lá a lista completa já aparece inteira.
const mostrarConvites = path !== "/workspaces";
const convitesPendentes = mostrarConvites
  ? await pendingInvitesFor(Astro.locals.env, user.email)
  : [];

const grupos = [
  ...(atual
    ? [
        {
          grupo: atual.workspaceName,
          itens: [
            ...(can(atual.role, PERMISSIONS.CONTENT_READ)
              ? [
                  { href: `/w/${atual.workspaceSlug}/time`, label: "Tempo" },
                  { href: `/w/${atual.workspaceSlug}/reports`, label: "Relatórios" },
                  { href: `/w/${atual.workspaceSlug}/projects`, label: "Projetos" },
                  { href: `/w/${atual.workspaceSlug}/integrations`, label: "API e MCP" },
                ]
              : []),
            ...(can(atual.role, PERMISSIONS.MEMBERS_READ)
              ? [{ href: `/w/${atual.workspaceSlug}/members`, label: "Membros" }]
              : []),
            ...(can(atual.role, PERMISSIONS.WORKSPACE_READ)
              ? [{ href: `/w/${atual.workspaceSlug}/settings`, label: "Configurações" }]
              : []),
          ],
        },
      ]
    : []),
  {
    grupo: "Conta",
    itens: [
      { href: "/dashboard/profile", label: "Meus dados" },
      { href: "/dashboard/security", label: "Segurança" },
    ],
  },
  ...(superadmin
    ? [
        {
          grupo: "Plataforma",
          itens: [
            { href: "/dashboard/admin/users", label: "Usuários" },
            { href: "/dashboard/admin/audit", label: "Auditoria" },
          ],
        },
      ]
    : []),
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <div class="app">
      <nav class="sidenav" aria-label="Navegação principal">
        <a class="brand" href="/dashboard"><span class="logo" aria-hidden="true"></span>{APP_NAME}</a>
        <details class="seletor-ws" open={!atual}>
          <summary>{atual ? atual.workspaceName : "Escolher workspace"}</summary>
          {meusWorkspaces.map((w) => (
            <a href={`/w/${w.workspaceSlug}/time`} aria-current={w.workspaceSlug === atual?.workspaceSlug ? "true" : undefined}>
              {w.workspaceName}
              <small class="muted"> · {ROLE_LABELS[w.role]}</small>
            </a>
          ))}
          <a href="/workspaces">+ Novo workspace</a>
        </details>

        {grupos.map((g) => (
          <>
            <div class="group">{g.grupo}</div>
            {g.itens.map((item) => (
              <a href={item.href} aria-current={path === item.href ? "page" : undefined}>{item.label}</a>
            ))}
          </>
        ))}
      </nav>

      <main class="content">
        <div class="page-head">
          <div>
            <h1>{heading}</h1>
            {description && <p class="muted">{description}</p>}
          </div>
          <div class="who">
            <span>
              {user.name}<br />
              {atual
                ? <span class="badge">{ROLE_LABELS[atual.role]} · {atual.workspaceName}</span>
                : superadmin
                  ? <span class="badge badge-admin">Superadmin da plataforma</span>
                  : <span class="badge">Conta</span>}
            </span>
            <span class="avatar" aria-hidden="true">{user.name.trim().charAt(0).toUpperCase()}</span>
            <form method="post" action="/api/logout" class="inline-form">
              <button class="btn-ghost btn-sm" type="submit">Sair</button>
            </form>
          </div>
        </div>
        <Alert error={params.get("e")} success={params.get("ok")} />
        <PendingInvites convites={convitesPendentes} verificado={user.emailVerified} limite={3} />
        <slot />
      </main>
    </div>
  </body>
</html>
