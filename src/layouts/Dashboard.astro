---
import Alert from "~/components/Alert.astro";
import PendingInvites from "~/components/PendingInvites.astro";
import { APP_NAME } from "~/config";
import { pendingInvitesFor } from "~/lib/members";
import { ROLE_LABELS, canAdministerPlatform, can, PERMISSIONS } from "~/lib/permissions";
import { userWorkspaces } from "~/lib/workspaces";
import "~/styles/global.css";

interface Props {
  title: string;
  heading: string;
  description?: string;
}

const { title, heading, description } = Astro.props;
const user = Astro.locals.user!;
const current = Astro.locals.membership;
const superadmin = canAdministerPlatform(user.role);
const path = Astro.url.pathname;
const params = Astro.url.searchParams;

// For the switcher. One query per rendered page is cheap and keeps the list
// from going stale after creating or leaving a workspace.
const myWorkspaces = await userWorkspaces(Astro.locals.env, user.id);

// An invite used to exist only in the email link. Whoever deleted the message
// had no way in at all, even while logged in — hence the notice at the top of
// the dashboard. On `/workspaces` it is omitted because the full list is already
// shown there.
const showInvites = path !== "/workspaces";
const pendingInvites = showInvites
  ? await pendingInvitesFor(Astro.locals.env, user.email)
  : [];

const groups = [
  ...(current
    ? [
        {
          group: current.workspaceName,
          items: [
            ...(can(current.role, PERMISSIONS.CONTENT_READ)
              ? [
                  { href: `/w/${current.workspaceSlug}/time`, label: "Time" },
                  { href: `/w/${current.workspaceSlug}/reports`, label: "Reports" },
                  { href: `/w/${current.workspaceSlug}/projects`, label: "Projects" },
                  { href: `/w/${current.workspaceSlug}/integrations`, label: "API & MCP" },
                ]
              : []),
            ...(can(current.role, PERMISSIONS.MEMBERS_READ)
              ? [{ href: `/w/${current.workspaceSlug}/members`, label: "Members" }]
              : []),
            ...(can(current.role, PERMISSIONS.WORKSPACE_READ)
              ? [{ href: `/w/${current.workspaceSlug}/settings`, label: "Settings" }]
              : []),
          ],
        },
      ]
    : []),
  {
    group: "Account",
    items: [
      { href: "/dashboard/profile", label: "My details" },
      { href: "/dashboard/security", label: "Security" },
    ],
  },
  ...(superadmin
    ? [
        {
          group: "Platform",
          items: [
            { href: "/dashboard/admin/users", label: "Users" },
            { href: "/dashboard/admin/audit", label: "Audit log" },
          ],
        },
      ]
    : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <div class="app">
      <nav class="sidenav" aria-label="Main navigation">
        <a class="brand" href="/dashboard"><span class="logo" aria-hidden="true"></span>{APP_NAME}</a>
        <details class="ws-picker" open={!current}>
          <summary>{current ? current.workspaceName : "Choose workspace"}</summary>
          {myWorkspaces.map((w) => (
            <a href={`/w/${w.workspaceSlug}/time`} aria-current={w.workspaceSlug === current?.workspaceSlug ? "true" : undefined}>
              {w.workspaceName}
              <small class="muted"> · {ROLE_LABELS[w.role]}</small>
            </a>
          ))}
          <a href="/workspaces">+ New workspace</a>
        </details>

        {groups.map((g) => (
          <>
            <div class="group">{g.group}</div>
            {g.items.map((item) => (
              <a href={item.href} aria-current={path === item.href ? "page" : undefined}>{item.label}</a>
            ))}
          </>
        ))}
      </nav>

      <main class="content">
        <div class="page-head">
          <div>
            <h1>{heading}</h1>
            {description && <p class="muted">{description}</p>}
          </div>
          <div class="who">
            <span>
              {user.name}<br />
              {current
                ? <span class="badge">{ROLE_LABELS[current.role]} · {current.workspaceName}</span>
                : superadmin
                  ? <span class="badge badge-admin">Platform superadmin</span>
                  : <span class="badge">Account</span>}
            </span>
            <span class="avatar" aria-hidden="true">{user.name.trim().charAt(0).toUpperCase()}</span>
            <form method="post" action="/api/logout" class="inline-form">
              <button class="btn-ghost btn-sm" type="submit">Log out</button>
            </form>
          </div>
        </div>
        <Alert error={params.get("e")} success={params.get("ok")} />
        <PendingInvites invites={pendingInvites} verified={user.emailVerified} limit={3} />
        <slot />
      </main>
    </div>
  </body>
</html>
