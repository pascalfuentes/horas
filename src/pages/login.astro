---
import SocialButtons from "~/components/SocialButtons.astro";
import Turnstile from "~/components/Turnstile.astro";
import Auth from "~/layouts/Auth.astro";
import { safeNext } from "~/lib/http";

export const prerender = false;

const next = safeNext(Astro.url.searchParams.get("next") ?? "");
---

<Auth title="Log in" heading="Log in" subheading="Access your account to continue.">
  <form method="post" action="/api/login" class="stack">
    <input type="hidden" name="next" value={next} />

    <div class="field">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="username" required autofocus />
    </div>

    <div class="field">
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required />
    </div>

    <Turnstile />
    <button class="btn-block" type="submit">Log in</button>
  </form>

  <SocialButtons next={next} verb="Log in with" />

  <p class="auth-foot">
    <a href="/forgot-password">Forgot my password</a>
  </p>
  <p class="auth-foot">Don't have an account yet? <a href="/signup">Create account</a></p>
  <p class="auth-foot muted">
    <small><a href="/privacy">Privacy policy</a></small>
  </p>
</Auth>
