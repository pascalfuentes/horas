---
import SocialButtons from "~/components/SocialButtons.astro";
import Turnstile from "~/components/Turnstile.astro";
import Auth from "~/layouts/Auth.astro";
import { safeNext } from "~/lib/http";

export const prerender = false;

const next = safeNext(Astro.url.searchParams.get("next") ?? "");
---

<Auth title="Entrar" heading="Entrar" subheading="Acesse sua conta para continuar.">
  <form method="post" action="/api/login" class="stack">
    <input type="hidden" name="next" value={next} />

    <div class="field">
      <label for="email">E-mail</label>
      <input id="email" name="email" type="email" autocomplete="username" required autofocus />
    </div>

    <div class="field">
      <label for="senha">Senha</label>
      <input id="senha" name="password" type="password" autocomplete="current-password" required />
    </div>

    <Turnstile />
    <button class="btn-block" type="submit">Entrar</button>
  </form>

  <SocialButtons next={next} verbo="Entrar com" />

  <p class="auth-foot">
    <a href="/forgot-password">Esqueci minha senha</a>
  </p>
  <p class="auth-foot">Ainda não tem conta? <a href="/signup">Criar conta</a></p>
  <p class="auth-foot muted">
    <small><a href="/privacy">Política de privacidade</a></small>
  </p>
</Auth>
