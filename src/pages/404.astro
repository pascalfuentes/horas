---
import Auth from "~/layouts/Auth.astro";
export const prerender = false;
---
<Auth title="Page not found" heading="Page not found" subheading="The address you opened does not exist here.">
  <p class="muted">
    If you got here from an invite or password reset link, it has probably already expired
    or been used. Request a new one.
  </p>
  <a class="btn btn-block" href="/login">Go to login</a>
</Auth>
