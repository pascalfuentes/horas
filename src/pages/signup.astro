---
import SocialButtons from "~/components/SocialButtons.astro";
import Turnstile from "~/components/Turnstile.astro";
import Auth from "~/layouts/Auth.astro";

export const prerender = false;
---

<Auth
  title="Create account"
  heading="Create account"
  subheading="You will receive an email to confirm your address before logging in."
  pitch="Know where your hours go."
  pitchText="A timer, projects, budgets and reports, free. Connect your AI and track time without opening a tab."
>
  <form method="post" action="/api/signup" class="stack">
    <div class="field">
      <label for="name">Your name</label>
      <input id="name" name="name" type="text" autocomplete="name" required autofocus />
    </div>

    <div class="field">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="username" required />
    </div>

    <div class="field">
      <label for="password">Password</label>
      <input id="password" name="password" type="password" minlength="10" autocomplete="new-password" required />
      <span class="hint">At least 10 characters.</span>
    </div>

    <div class="field">
      <label for="confirm">Confirm password</label>
      <input id="confirm" name="confirm" type="password" minlength="10" autocomplete="new-password" required />
    </div>

    <Turnstile />
    <button class="btn-block" type="submit">Create account</button>
  </form>

  <SocialButtons verb="Create account with" />

  <p class="auth-foot">Already have an account? <a href="/login">Log in</a></p>
  <p class="auth-foot muted">
    <small><a href="/privacy">Privacy policy</a></small>
  </p>
</Auth>
