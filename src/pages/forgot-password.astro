---
import Turnstile from "~/components/Turnstile.astro";
import Auth from "~/layouts/Auth.astro";

export const prerender = false;
---

<Auth
  title="Esqueci minha senha"
  heading="Esqueci minha senha"
  subheading="Enviamos um link para você definir uma nova senha."
>
  <form method="post" action="/api/forgot-password" class="stack">
    <div class="field">
      <label for="email">E-mail da conta</label>
      <input id="email" name="email" type="email" autocomplete="username" required autofocus />
    </div>
    <Turnstile />
    <button class="btn-block" type="submit">Enviar link</button>
  </form>

  <p class="auth-foot"><a href="/login">Voltar para o login</a></p>
</Auth>
