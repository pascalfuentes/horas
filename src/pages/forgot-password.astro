---
import Turnstile from "~/components/Turnstile.astro";
import Auth from "~/layouts/Auth.astro";

export const prerender = false;
---

<Auth
  title="Forgot my password"
  heading="Forgot my password"
  subheading="We will send you a link to set a new password."
>
  <form method="post" action="/api/forgot-password" class="stack">
    <div class="field">
      <label for="email">Account email</label>
      <input id="email" name="email" type="email" autocomplete="username" required autofocus />
    </div>
    <Turnstile />
    <button class="btn-block" type="submit">Send link</button>
  </form>

  <p class="auth-foot"><a href="/login">Back to login</a></p>
</Auth>
