---
import { APP_NAME, operador } from "~/config";
import { contarAdminsPlataforma } from "~/lib/plataforma";
import "~/styles/global.css";

export const prerender = false;

if (Astro.locals.user) return Astro.redirect("/dashboard");

// Sem superadmin = instalação nova, manda para o bootstrap.
// Com cadastro aberto, "banco vazio" não serviria como condição: bastava
// alguém se cadastrar antes para o posto ficar inalcançável.
if ((await contarAdminsPlataforma(Astro.locals.env)) === 0) return Astro.redirect("/setup");

const autor = operador(Astro.locals.env).nome;
const descricao =
  "Controle de tempo gratuito que conversa com a sua IA. Inicie timers, lance horas e peça relatórios pelo Claude ou qualquer cliente MCP.";

const recursos = [
  ["Timer de um clique", "Comece, pare e continue de onde parou. O relógio segue na aba do navegador e sincroniza entre dispositivos."],
  ["Projetos e faturamento", "Organize por projeto e cliente, defina o valor por hora e veja quanto faturar no fim do mês."],
  ["Relatórios e CSV", "Veja para onde a semana foi, por dia, projeto, cliente ou tag — e exporte quando precisar."],
  ["Workspaces e convites", "Um espaço só seu ou compartilhado com o time, com papéis por pessoa."],
  ["Conta protegida", "Login com e-mail e senha, Google ou GitHub, verificação em duas etapas e sessões por dispositivo."],
  ["Seus dados são seus", "Baixe tudo ou apague a conta quando quiser. Sem anúncios, sem rastreadores."],
];

const ferramentas = ["get_status", "start_timer", "stop_timer", "add_entry", "summary_report", "list_entries", "list_projects", "list_tags"];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descricao} />
    <meta property="og:title" content={`${APP_NAME} — controle de tempo que conversa com a sua IA`} />
    <meta property="og:description" content={descricao} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{APP_NAME} — controle de tempo que conversa com a sua IA</title>
  </head>
  <body class="lp">
    <div class="lp-top">
      <header class="lp-nav">
        <a class="brand" href="/"><span class="logo" aria-hidden="true"></span>{APP_NAME}</a>
        <nav>
          <a href="#mcp">MCP</a>
          <a href="#recursos">Recursos</a>
          <a href="/login">Entrar</a>
          <a class="btn btn-coral" href="/cadastro">Criar conta</a>
        </nav>
      </header>

      <section class="lp-hero">
        <div class="lp-copy">
          <span class="badge badge-sun">Gratuito · feito para trabalhar com IA</span>
          <h1>O controle de tempo que você não precisa abrir.</h1>
          <svg class="lp-rabisco" viewBox="0 0 342 16" aria-hidden="true"><path d="M2 10C60 2 130 14 200 6C250 1 300 9 340 5" /></svg>
          <p class="lp-lead">
            {APP_NAME} é um time tracker simples com um servidor MCP embutido. Diga ao Claude
            “comecei a revisão do site” e o timer já está rodando.
          </p>
          <div class="lp-cta">
            <a class="btn" href="/cadastro">Começar de graça</a>
            <a class="btn btn-ghost" href="/login">Já tenho conta</a>
          </div>
        </div>

        <div class="lp-demo" aria-hidden="true">
          <div class="lp-chat">
            <div class="lp-msg lp-eu">Comece um timer para a revisão do site, projeto Acme.</div>
            <div class="lp-msg lp-ia"><small>start_timer</small>Pronto — timer rodando em Acme desde 09:12.</div>
            <div class="lp-msg lp-eu">Quanto trabalhei essa semana?</div>
            <div class="lp-msg lp-ia"><small>summary_report</small>18h 40min: Acme 11h 05min, Portfólio 5h 20min, Estudos 2h 15min.</div>
          </div>
          <div class="lp-timer">
            <i></i><span>Revisão do site</span><b>0:42:17</b><em>Parar</em>
          </div>
        </div>
      </section>
    </div>

    <main>
      <section class="lp-section" id="recursos">
        <h2>Tudo o que um time tracker precisa. Nada além.</h2>
        <div class="lp-grid">
          {recursos.map(([titulo, texto], i) => (
            <div class={`lp-feat lp-feat-${i % 3}`}>
              <h3>{titulo}</h3>
              <p>{texto}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="lp-mcp" id="mcp">
        <div>
          <h2>Conecte em um minuto</h2>
          <p>
            Gere um token pessoal no painel e cole a URL no seu cliente. Funciona com Claude,
            Claude Code, Cursor, VS Code e qualquer aplicativo compatível com o Model Context
            Protocol. Para scripts, a mesma coisa está disponível como API REST.
          </p>
          <ul class="lp-tools">
            {ferramentas.map((f, i) => <li class={`lp-tool-${i % 5}`}>{f}</li>)}
          </ul>
        </div>
        <pre class="lp-code">{`claude mcp add --transport http horas \\
  ${Astro.url.origin}/mcp \\
  --header "Authorization: Bearer hrs_…"`}</pre>
      </section>

      <section class="lp-final">
        <h2>Comece a marcar seu tempo hoje.</h2>
        <p>Gratuito. Sem anúncios, sem rastreadores.</p>
        <a class="btn btn-dark" href="/cadastro">Criar conta</a>
      </section>
    </main>

    <footer class="lp-foot">
      <span>Feito por {autor} · Astro, Cloudflare Workers e D1</span>
      <a href="/privacidade">Privacidade</a>
    </footer>
  </body>
</html>

<style>
  /* Landing: página branca com painéis coloridos bem arredondados. */
  .lp { background: var(--surface); padding: 20px; display: flex; flex-direction: column; gap: 20px; }
  .lp main { display: flex; flex-direction: column; gap: 20px; }
  .lp-top, .lp-section, .lp-mcp, .lp-final, .lp-foot { width: 100%; max-width: 1400px; margin: 0 auto; }
  .lp-top { background: var(--bg); border-radius: var(--radius-xl); padding: 28px clamp(20px, 5vw, 72px) clamp(48px, 6vw, 80px); }

  .lp-nav { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .lp-nav nav { display: flex; align-items: center; gap: clamp(16px, 2.5vw, 32px); font-weight: 500; }
  .lp-nav nav a:not(.btn) { text-decoration: none; }
  .lp-nav nav a:not(.btn):hover { text-decoration: underline; text-underline-offset: 4px; }

  .lp-hero { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(32px, 5vw, 64px); align-items: center; margin-top: clamp(40px, 6vw, 72px); }
  .lp-copy h1 { font-size: clamp(2.5rem, 5.2vw, 4rem); line-height: 1.06; margin: 24px 0 0; text-wrap: balance; }
  .lp-rabisco { display: block; width: min(342px, 70%); margin: 14px 0 20px; }
  .lp-rabisco path { fill: none; stroke: var(--accent); stroke-width: 5; stroke-linecap: round; }
  .lp-lead { font-size: 1.125rem; line-height: 1.55; color: var(--text-muted); max-width: 52ch; margin: 0 0 28px; }
  .lp-cta { display: flex; gap: 12px; flex-wrap: wrap; }

  .lp-demo { display: flex; flex-direction: column; gap: 12px; }
  .lp-chat, .lp-timer { background: var(--surface); border-radius: var(--radius-xl); box-shadow: var(--shadow); }
  .lp-chat { display: flex; flex-direction: column; gap: 12px; padding: 20px 24px; }
  .lp-msg { padding: 12px 16px; border-radius: var(--radius-lg); max-width: 88%; }
  .lp-eu { background: var(--ink); color: var(--ink-text); align-self: flex-end; border-bottom-right-radius: 6px; }
  .lp-ia { background: var(--surface-2); align-self: flex-start; border-bottom-left-radius: 6px; }
  .lp-ia small { display: block; font-family: var(--mono); font-size: 0.875rem; color: var(--text-muted); margin-bottom: 2px; }
  .lp-timer { display: flex; align-items: center; gap: 12px; padding: 16px 20px; font-weight: 500; }
  .lp-timer i { width: 12px; height: 12px; border-radius: 50%; background: var(--accent); flex: none; }
  .lp-timer span { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lp-timer b { font-family: var(--mono); font-weight: 500; font-size: 1.5rem; font-variant-numeric: tabular-nums; }
  .lp-timer em { font-style: normal; background: var(--stop); color: var(--accent-text); border: 1.5px solid var(--ink); box-shadow: var(--shadow-button); border-radius: 999px; padding: 10px 28px; }

  .lp-section { padding: clamp(40px, 5vw, 64px) clamp(20px, 5vw, 72px); }
  .lp-section > h2, .lp-mcp h2, .lp-final h2 { font-size: clamp(2rem, 4vw, 3rem); line-height: 1.12; letter-spacing: -0.025em; text-wrap: balance; }
  .lp-section > h2 { max-width: 18ch; margin-bottom: 32px; }
  .lp-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .lp-feat { border-radius: var(--radius-xl); padding: 32px; }
  .lp-feat-0 { background: var(--accent-subtle); }
  .lp-feat-1 { background: var(--coral-subtle); }
  .lp-feat-2 { background: var(--sun-subtle); }
  .lp-feat h3 { font-size: 1.625rem; margin-bottom: 12px; }
  .lp-feat p { margin: 0; }

  .lp-mcp { background: var(--ink); color: var(--ink-text); border-radius: var(--radius-xl); padding: clamp(40px, 5vw, 72px); display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 64px); align-items: center; }
  .lp-mcp p { font-size: 1.125rem; line-height: 1.55; opacity: 0.75; margin: 20px 0; }
  .lp-tools { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .lp-tools li { font-size: 0.875rem; font-weight: 500; padding: 4px 12px; border-radius: 999px; color: #1b1624; }
  .lp-tool-0 { background: #dff5fc; } .lp-tool-1 { background: #ddf6e9; } .lp-tool-2 { background: #fde4e1; } .lp-tool-3 { background: #fff5d9; } .lp-tool-4 { background: #ffe7dc; }
  .lp-code { margin: 0; padding: 24px; background: var(--surface); color: var(--text); border-radius: var(--radius-lg); font-family: var(--mono); font-size: 0.9375rem; line-height: 1.7; overflow-x: auto; }

  .lp-final { background: var(--sun); color: #1b1624; border-radius: var(--radius-xl); padding: clamp(48px, 6vw, 72px) 24px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 16px; }
  .lp-final p { font-size: 1.125rem; margin: 0 0 4px; }
  .lp-final .btn-dark { background: #1b1624; color: #fdfbf8; }
  .lp-foot { padding: 8px clamp(20px, 5vw, 72px) 20px; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; font-size: 0.875rem; color: var(--text-muted); }

  @media (max-width: 900px) {
    .lp { padding: 12px; gap: 12px; }
    .lp main { gap: 12px; }
    .lp-nav nav a:not(.btn):not([href="/login"]) { display: none; }
    .lp-hero, .lp-mcp { grid-template-columns: 1fr; }
    .lp-grid { grid-template-columns: 1fr; }
  }
</style>
