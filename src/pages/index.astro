---
import HeadIcons from "~/components/HeadIcons.astro";
import BusyForms from "~/components/BusyForms.astro";
import Theme from "~/components/Theme.astro";
import Logo from "~/components/Logo.astro";
import { APP_NAME, operator } from "~/config";
import { countPlatformAdmins } from "~/lib/platform";
import "~/styles/global.css";

export const prerender = false;

if (Astro.locals.user) return Astro.redirect("/dashboard");

// No superadmin = fresh install, send to the bootstrap.
// With open signup, "empty database" would not work as the condition: someone
// signing up first would be enough to make the role unreachable.
if ((await countPlatformAdmins(Astro.locals.env)) === 0) return Astro.redirect("/setup");

const author = operator(Astro.locals.env).name;
const description =
  "A free time tracker that talks to your AI. Start timers, log hours and ask for reports through Claude or any MCP client.";

const features = [
  ["One-click timer", "Start, stop and pick up where you left off. The clock keeps running in the browser tab and syncs across devices."],
  ["Projects and billing", "Organize by project and client, set an hourly rate and see how much to invoice at the end of the month."],
  ["Reports and CSV", "See where the week went, by day, project, client or tag — and export whenever you need."],
  ["Workspaces and invites", "A space of your own or shared with the team, with a role per person."],
  ["Protected account", "Log in with email and password, Google or GitHub, two-step verification and per-device sessions."],
  ["Your data is yours", "Download everything or delete your account whenever you want. No ads, no trackers."],
];

const tools = ["get_status", "start_timer", "stop_timer", "add_entry", "summary_report", "list_entries", "list_projects", "list_tags"];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={`${APP_NAME} — the time tracker that talks to your AI`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <HeadIcons />
    <title>{APP_NAME} — the time tracker that talks to your AI</title>
    <Theme />
    <BusyForms />
  </head>
  <body class="lp">
    <div class="lp-top">
      <header class="lp-nav">
        <a class="brand" href="/"><Logo />{APP_NAME}</a>
        <nav>
          <a href="#mcp">MCP</a>
          <a href="#features">Features</a>
          <a href="/login">Log in</a>
          <a class="btn btn-coral" href="/signup">Create account</a>
        </nav>
      </header>

      <section class="lp-hero">
        <div class="lp-copy">
          <span class="badge badge-sun">Free · built to work with AI</span>
          <h1>The time tracker you don't need to open.</h1>
          <svg class="lp-squiggle" viewBox="0 0 342 16" aria-hidden="true"><path d="M2 10C60 2 130 14 200 6C250 1 300 9 340 5" /></svg>
          <p class="lp-lead">
            {APP_NAME} is a simple time tracker with a built-in MCP server. Tell Claude
            “I just started the site review” and the timer is already running.
          </p>
          <div class="lp-cta">
            <a class="btn" href="/signup">Start for free</a>
            <a class="btn btn-ghost" href="/login">I already have an account</a>
          </div>
        </div>

        <div class="lp-demo" aria-hidden="true">
          <div class="lp-chat">
            <div class="lp-msg lp-me">Start a timer for the site review, project Acme.</div>
            <div class="lp-msg lp-ai"><small>start_timer</small>Done — timer running on Acme since 09:12.</div>
            <div class="lp-msg lp-me">How much did I work this week?</div>
            <div class="lp-msg lp-ai"><small>summary_report</small>18h 40min: Acme 11h 05min, Portfolio 5h 20min, Study 2h 15min.</div>
          </div>
          <div class="lp-timer">
            <i></i><span>Site review</span><b>0:42:17</b><em>Stop</em>
          </div>
        </div>
      </section>
    </div>

    <main>
      <section class="lp-section" id="features">
        <h2>Everything a time tracker needs. Nothing more.</h2>
        <div class="lp-grid">
          {features.map(([title, text], i) => (
            <div class={`lp-feat lp-feat-${i % 3}`}>
              <h3>{title}</h3>
              <p>{text}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="lp-mcp" id="mcp">
        <div>
          <h2>Connect in a minute</h2>
          <p>
            Generate a personal token in the dashboard and paste the URL into your client. Works
            with Claude, Claude Code, Cursor, VS Code and any app compatible with the Model Context
            Protocol. For scripts, the same thing is available as a REST API.
          </p>
          <ul class="lp-tools">
            {tools.map((f, i) => <li class={`lp-tool-${i % 5}`}>{f}</li>)}
          </ul>
        </div>
        <pre class="lp-code">{`claude mcp add --transport http clockfolio \\
  ${Astro.url.origin}/mcp \\
  --header "Authorization: Bearer hrs_…"`}</pre>
      </section>

      <section class="lp-final">
        <h2>Start tracking your time today.</h2>
        <p>Free. No ads, no trackers.</p>
        <a class="btn btn-dark" href="/signup">Create account</a>
      </section>
    </main>

    <footer class="lp-foot">
      <span>Made by {author} · Astro, Cloudflare Workers and D1</span>
      <a href="/privacy">Privacy</a>
    </footer>
  </body>
</html>

<style>
  /* Landing: white page with heavily rounded colored panels. */
  .lp { background: var(--surface); padding: 20px; display: flex; flex-direction: column; gap: 20px; }
  .lp main { display: flex; flex-direction: column; gap: 20px; }
  .lp-top, .lp-section, .lp-mcp, .lp-final, .lp-foot { width: 100%; max-width: 1400px; margin: 0 auto; }
  .lp-top { background: var(--bg); border-radius: var(--radius-xl); padding: 28px clamp(20px, 5vw, 72px) clamp(48px, 6vw, 80px); }

  .lp-nav { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .lp-nav nav { display: flex; align-items: center; gap: clamp(16px, 2.5vw, 32px); font-weight: 500; }
  .lp-nav nav a:not(.btn) { text-decoration: none; }
  .lp-nav nav a:not(.btn):hover { text-decoration: underline; text-underline-offset: 4px; }

  .lp-hero { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(32px, 5vw, 64px); align-items: center; margin-top: clamp(40px, 6vw, 72px); }
  .lp-copy h1 { font-size: clamp(2.5rem, 5.2vw, 4rem); line-height: 1.06; margin: 24px 0 0; text-wrap: balance; }
  .lp-squiggle { display: block; width: min(342px, 70%); margin: 14px 0 20px; }
  .lp-squiggle path { fill: none; stroke: var(--accent); stroke-width: 5; stroke-linecap: round; }
  .lp-lead { font-size: 1.125rem; line-height: 1.55; color: var(--text-muted); max-width: 52ch; margin: 0 0 28px; }
  .lp-cta { display: flex; gap: 12px; flex-wrap: wrap; }

  .lp-demo { display: flex; flex-direction: column; gap: 12px; }
  .lp-chat, .lp-timer { background: var(--surface); border-radius: var(--radius-xl); box-shadow: var(--shadow); }
  .lp-chat { display: flex; flex-direction: column; gap: 12px; padding: 20px 24px; }
  .lp-msg { padding: 12px 16px; border-radius: var(--radius-lg); max-width: 88%; }
  .lp-me { background: var(--ink); color: var(--ink-text); align-self: flex-end; border-bottom-right-radius: 6px; }
  .lp-ai { background: var(--surface-2); align-self: flex-start; border-bottom-left-radius: 6px; }
  .lp-ai small { display: block; font-family: var(--mono); font-size: 0.875rem; color: var(--text-muted); margin-bottom: 2px; }
  .lp-timer { display: flex; align-items: center; gap: 12px; padding: 16px 20px; font-weight: 500; }
  .lp-timer i { width: 12px; height: 12px; border-radius: 50%; background: var(--accent); flex: none; }
  .lp-timer span { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lp-timer b { font-family: var(--mono); font-weight: 500; font-size: 1.5rem; font-variant-numeric: tabular-nums; }
  .lp-timer em { font-style: normal; background: var(--stop); color: var(--accent-text); border: 1.5px solid var(--ink); box-shadow: var(--shadow-button); border-radius: 999px; padding: 10px 28px; }

  .lp-section { padding: clamp(40px, 5vw, 64px) clamp(20px, 5vw, 72px); }
  .lp-section > h2, .lp-mcp h2, .lp-final h2 { font-size: clamp(2rem, 4vw, 3rem); line-height: 1.12; letter-spacing: -0.025em; text-wrap: balance; }
  .lp-section > h2 { max-width: 18ch; margin-bottom: 32px; }
  .lp-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .lp-feat { border-radius: var(--radius-xl); padding: 32px; }
  .lp-feat-0 { background: var(--accent-subtle); }
  .lp-feat-1 { background: var(--coral-subtle); }
  .lp-feat-2 { background: var(--sun-subtle); }
  .lp-feat h3 { font-size: 1.625rem; margin-bottom: 12px; }
  .lp-feat p { margin: 0; }

  .lp-mcp { background: var(--ink); color: var(--ink-text); border-radius: var(--radius-xl); padding: clamp(40px, 5vw, 72px); display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 64px); align-items: center; }
  .lp-mcp p { font-size: 1.125rem; line-height: 1.55; opacity: 0.75; margin: 20px 0; }
  .lp-tools { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .lp-tools li { font-size: 0.875rem; font-weight: 500; padding: 4px 12px; border-radius: 999px; color: #1b1624; }
  .lp-tool-0 { background: #dff5fc; } .lp-tool-1 { background: #ddf6e9; } .lp-tool-2 { background: #fde4e1; } .lp-tool-3 { background: #fff5d9; } .lp-tool-4 { background: #ffe7dc; }
  .lp-code { margin: 0; padding: 24px; background: var(--surface); color: var(--text); border-radius: var(--radius-lg); font-family: var(--mono); font-size: 0.9375rem; line-height: 1.7; overflow-x: auto; }

  .lp-final { background: var(--sun); color: #1b1624; border-radius: var(--radius-xl); padding: clamp(48px, 6vw, 72px) 24px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 16px; }
  .lp-final p { font-size: 1.125rem; margin: 0 0 4px; }
  .lp-final .btn-dark { background: #1b1624; color: #fdfbf8; }
  .lp-foot { padding: 8px clamp(20px, 5vw, 72px) 20px; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; font-size: 0.875rem; color: var(--text-muted); }

  @media (max-width: 900px) {
    .lp { padding: 12px; gap: 12px; }
    .lp main { gap: 12px; }
    .lp-nav nav a:not(.btn):not([href="/login"]) { display: none; }
    .lp-hero, .lp-mcp { grid-template-columns: 1fr; }
    .lp-grid { grid-template-columns: 1fr; }
  }
</style>
