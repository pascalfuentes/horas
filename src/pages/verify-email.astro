---
import Auth from "~/layouts/Auth.astro";

export const prerender = false;

/**
 * The email does NOT travel in the URL on purpose: it would end up in the
 * browser history and in the Referer of any link clicked from here. Whoever
 * wants a resend types it again — and the resend responds the same whether the
 * address exists or not.
 */
---

<Auth
  title="Confirm your email"
  heading="Confirm your email"
  subheading="We sent a link to the address you provided."
>
  <p class="muted">
    Open the link to activate your account. It is valid for 1 hour. If it has not arrived in a
    few minutes, check your spam folder or request another one below.
  </p>

  <form method="post" action="/api/resend-verification" class="stack">
    <div class="field">
      <label for="email">Signup email</label>
      <input id="email" name="email" type="email" autocomplete="username" required />
    </div>
    <button class="btn-ghost btn-block" type="submit">Resend the link</button>
  </form>

  <p class="auth-foot"><a href="/login">Back to login</a></p>
</Auth>
