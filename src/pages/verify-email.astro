---
import Auth from "~/layouts/Auth.astro";

export const prerender = false;

/**
 * O e-mail NÃO viaja na URL de propósito: ficaria no histórico do navegador e
 * no Referer de qualquer link clicado a partir daqui. Quem quiser reenviar
 * digita de novo — e o reenvio responde igual para endereço existente ou não.
 */
---

<Auth
  title="Confirme seu e-mail"
  heading="Confirme seu e-mail"
  subheading="Enviamos um link para o endereço informado."
>
  <p class="muted">
    Abra o link para ativar sua conta. Ele vale por 1 hora. Se não chegou em alguns minutos,
    confira a caixa de spam ou peça outro abaixo.
  </p>

  <form method="post" action="/api/resend-verification" class="stack">
    <div class="field">
      <label for="email">E-mail do cadastro</label>
      <input id="email" name="email" type="email" autocomplete="username" required />
    </div>
    <button class="btn-ghost btn-block" type="submit">Reenviar o link</button>
  </form>

  <p class="auth-foot"><a href="/login">Voltar ao login</a></p>
</Auth>
