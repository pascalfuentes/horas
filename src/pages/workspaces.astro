---
import PendingInvites from "~/components/PendingInvites.astro";
import Dashboard from "~/layouts/Dashboard.astro";
import { pendingInvitesFor } from "~/lib/members";
import { ROLE_DESCRIPTIONS, ROLE_LABELS } from "~/lib/permissions";
import { userWorkspaces } from "~/lib/workspaces";

export const prerender = false;

const eu = Astro.locals.user!;
const meus = await userWorkspaces(Astro.locals.env, eu.id);

// Aqui a lista vem inteira: esta é a página que responde "de onde eu
// participo", e um convite pendente faz parte dessa resposta. O layout omite o
// aviso do topo nesta rota justamente para não duplicar.
const convites = await pendingInvitesFor(Astro.locals.env, eu.email);
---

<Dashboard
  title="Workspaces"
  heading="Seus workspaces"
  description="Cada workspace tem os próprios dados, membros e permissões."
>
  {convites.length > 0 && (
    <PendingInvites convites={convites} verificado={eu.emailVerified} />
  )}

  <div class="card">
    <h2>Criar workspace</h2>
    <span class="muted">Você entra como dono e can convidar quem quiser depois.</span>

    <form method="post" action="/api/workspaces" class="row">
      <div class="field">
        <label for="nome">Nome</label>
        <input id="nome" name="name" type="text" maxlength="60" required />
      </div>
      <div><button type="submit">Criar</button></div>
    </form>
  </div>

  <div class="card">
    <h2>Onde você participa ({meus.length})</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Workspace</th><th>Seu papel</th><th>O que isso permite</th><th></th></tr></thead>
        <tbody>
          {meus.map((w) => (
            <tr>
              <td class="wrap"><strong>{w.workspaceName}</strong><br /><small class="muted">/w/{w.workspaceSlug}</small></td>
              <td><span class={`badge ${w.role === "owner" ? "badge-admin" : ""}`}>{ROLE_LABELS[w.role]}</span></td>
              <td class="wrap"><small class="muted">{ROLE_DESCRIPTIONS[w.role]}</small></td>
              <td><a class="btn btn-ghost btn-sm" href={`/w/${w.workspaceSlug}`}>Abrir</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</Dashboard>
