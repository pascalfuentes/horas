---
import PendingInvites from "~/components/PendingInvites.astro";
import Dashboard from "~/layouts/Dashboard.astro";
import { pendingInvitesFor } from "~/lib/members";
import { ROLE_DESCRIPTIONS, ROLE_LABELS } from "~/lib/permissions";
import { userWorkspaces } from "~/lib/workspaces";

export const prerender = false;

const me = Astro.locals.user!;
const mine = await userWorkspaces(Astro.locals.env, me.id);

// Here the list comes in full: this is the page that answers "where do I
// belong", and a pending invite is part of that answer. The layout omits the
// top notice on this route precisely to avoid duplicating it.
const invites = await pendingInvitesFor(Astro.locals.env, me.email);
---

<Dashboard
  title="Workspaces"
  heading="Your workspaces"
  description="Each workspace has its own data, members and permissions."
>
  {invites.length > 0 && (
    <PendingInvites invites={invites} verified={me.emailVerified} />
  )}

  <div class="card">
    <h2>Create workspace</h2>
    <span class="muted">You join as owner and can invite anyone you like later.</span>

    <form method="post" action="/api/workspaces" class="row">
      <div class="field">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" maxlength="60" required />
      </div>
      <div><button type="submit">Create</button></div>
    </form>
  </div>

  <div class="card">
    <h2>Where you belong ({mine.length})</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Workspace</th><th>Your role</th><th>What it allows</th><th></th></tr></thead>
        <tbody>
          {mine.map((w) => (
            <tr>
              <td class="wrap"><strong>{w.workspaceName}</strong><br /><small class="muted">/w/{w.workspaceSlug}</small></td>
              <td><span class={`badge ${w.role === "owner" ? "badge-admin" : ""}`}>{ROLE_LABELS[w.role]}</span></td>
              <td class="wrap"><small class="muted">{ROLE_DESCRIPTIONS[w.role]}</small></td>
              <td><a class="btn btn-ghost btn-sm" href={`/w/${w.workspaceSlug}`}>Open</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</Dashboard>
