---
import Dashboard from "~/layouts/Dashboard.astro";
import { ROLE_DESCRIPTIONS, ROLE_LABELS, PERMISSIONS, can } from "~/lib/permissions";

export const prerender = false;

// O middleware já resolveu e conferiu a membership a partir do slug — chegar
// aqui com `membership` nulo é impossível.
const ws = Astro.locals.membership!;
const permissoes: Array<[string, boolean]> = [
  ["Ler o conteúdo", can(ws.role, PERMISSIONS.CONTENT_READ)],
  ["Criar e editar conteúdo", can(ws.role, PERMISSIONS.CONTENT_WRITE)],
  ["Ver membros", can(ws.role, PERMISSIONS.MEMBERS_READ)],
  ["Convidar e gerenciar membros", can(ws.role, PERMISSIONS.MEMBERS_WRITE)],
  ["Mudar configurações", can(ws.role, PERMISSIONS.WORKSPACE_WRITE)],
  ["Excluir o workspace", can(ws.role, PERMISSIONS.WORKSPACE_DELETE)],
];
---

<Dashboard title={ws.workspaceName} heading={ws.workspaceName} description="Início do workspace.">
  <div class="card">
    <h2>Seu papel aqui</h2>
    <span class="muted">O papel é por workspace — você can ter outro em outro lugar.</span>
    <p>
      <span class={`badge ${ws.role === "owner" ? "badge-admin" : ""}`}>{ROLE_LABELS[ws.role]}</span>
      <br /><small class="muted">{ROLE_DESCRIPTIONS[ws.role]}</small>
    </p>
  </div>

  <div class="card">
    <h2>O que você can fazer aqui</h2>
    <span class="muted">Derivado da matriz em <code>src/lib/permissions.ts</code>.</span>
    <ul>
      {permissoes.map(([rotulo, permitido]) => (
        <li>{rotulo} — <strong>{permitido ? "sim" : "não"}</strong></li>
      ))}
    </ul>
  </div>
</Dashboard>
