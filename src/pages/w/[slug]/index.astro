---
import Dashboard from "~/layouts/Dashboard.astro";
import { ROLE_DESCRIPTIONS, ROLE_LABELS, PERMISSIONS, can } from "~/lib/permissions";

export const prerender = false;

// The middleware has already resolved and checked the membership from the
// slug — getting here with a null `membership` is impossible.
const ws = Astro.locals.membership!;
const permissions: Array<[string, boolean]> = [
  ["Read content", can(ws.role, PERMISSIONS.CONTENT_READ)],
  ["Create and edit content", can(ws.role, PERMISSIONS.CONTENT_WRITE)],
  ["View members", can(ws.role, PERMISSIONS.MEMBERS_READ)],
  ["Invite and manage members", can(ws.role, PERMISSIONS.MEMBERS_WRITE)],
  ["Change settings", can(ws.role, PERMISSIONS.WORKSPACE_WRITE)],
  ["Delete workspace", can(ws.role, PERMISSIONS.WORKSPACE_DELETE)],
];
---

<Dashboard title={ws.workspaceName} heading={ws.workspaceName} description="Workspace home.">
  <div class="card">
    <h2>Your role here</h2>
    <span class="muted">Roles are per workspace — you can have a different one elsewhere.</span>
    <p>
      <span class={`badge ${ws.role === "owner" ? "badge-admin" : ""}`}>{ROLE_LABELS[ws.role]}</span>
      <br /><small class="muted">{ROLE_DESCRIPTIONS[ws.role]}</small>
    </p>
  </div>

  <div class="card">
    <h2>What you can do here</h2>
    <span class="muted">Derived from the matrix in <code>src/lib/permissions.ts</code>.</span>
    <ul>
      {permissions.map(([label, allowed]) => (
        <li>{label} — <strong>{allowed ? "yes" : "no"}</strong></li>
      ))}
    </ul>
  </div>
</Dashboard>
