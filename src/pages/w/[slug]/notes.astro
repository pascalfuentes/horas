---
import { desc, eq } from "drizzle-orm";

import Dashboard from "~/layouts/Dashboard.astro";
import { note, user as userTable } from "~/db/schema";
import { getDb } from "~/lib/auth";
import { formatDateTime } from "~/lib/format";
import { PERMISSIONS, can } from "~/lib/permissions";

export const prerender = false;

const ws = Astro.locals.membership!;
const canWrite = can(ws.role, PERMISSIONS.CONTENT_WRITE);

// EVERY business data query filters by workspace. Without this `where`, a
// person would see the content of workspaces they are not even a member of.
const notes = await getDb(Astro.locals.env)
  .select({
    id: note.id,
    title: note.title,
    body: note.body,
    createdAt: note.createdAt,
    author: userTable.name,
  })
  .from(note)
  .leftJoin(userTable, eq(note.authorId, userTable.id))
  .where(eq(note.workspaceId, ws.workspaceId))
  .orderBy(desc(note.createdAt))
  .limit(50)
  .all();
---

<Dashboard
  title={`Notes — ${ws.workspaceName}`}
  heading="Notes"
  description="Demo module — it exists to show workspace roles at work."
>
  {canWrite ? (
    <div class="card">
      <h2>New note</h2>
      <form method="post" action={`/api/w/${ws.workspaceSlug}/notes`} class="stack">
        <div class="field">
          <label for="title">Title</label>
          <input id="title" name="title" type="text" maxlength="160" required />
        </div>
        <div class="field">
          <label for="body">Content</label>
          <textarea id="body" name="body" maxlength="4000"></textarea>
        </div>
        <div><button type="submit">Save</button></div>
      </form>
    </div>
  ) : (
    <p class="alert alert-info">
      <span>
        Your role here is read-only, so the form does not show. More importantly:
        a direct POST to <code>/api/w/{ws.workspaceSlug}/notes</code> also gets a 403 —
        authorization lives on the server, not in the interface.
      </span>
    </p>
  )}

  <div class="card">
    <h2>Notes in this workspace ({notes.length})</h2>
    {notes.length === 0 ? (
      <p class="empty">No notes yet.</p>
    ) : (
      <div class="table-wrap">
        <table>
          <thead><tr><th>Title</th><th>Content</th><th>Author</th><th>Created</th></tr></thead>
          <tbody>
            {notes.map((n) => (
              <tr>
                <td class="wrap"><strong>{n.title}</strong></td>
                <td class="wrap">{n.body.slice(0, 120)}</td>
                <td>{n.author ?? "—"}</td>
                <td>{formatDateTime(n.createdAt)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</Dashboard>
