---
import Dashboard from "~/layouts/Dashboard.astro";
import { PERMISSIONS, can } from "~/lib/permissions";
import "~/styles/horas.css";

export const prerender = false;

const ws = Astro.locals.membership!;
// Only a plain number is a project id; anything else is not a page.
const id = Astro.params.id ?? "";
if (!/^\d{1,10}$/.test(id)) return Astro.rewrite("/404");

const back = `/w/${ws.workspaceSlug}/projects`;
---

<Dashboard title={`Project — ${ws.workspaceName}`} heading="Project" description="Project settings.">
  <a class="hr-back" href={back}>← All projects</a>
  <div
    id="horas-app"
    data-view="project"
    data-project={id}
    data-back={back}
    data-base={`/api/w/${ws.workspaceSlug}/horas`}
    data-write={can(ws.role, PERMISSIONS.CONTENT_WRITE) ? "1" : "0"}
  >
    <p class="muted">Loading…</p>
  </div>
  <noscript><p class="alert alert-error">This screen needs JavaScript.</p></noscript>
  <script is:inline src="/app/horas.js" defer></script>
</Dashboard>
