---
import Dashboard from "~/layouts/Dashboard.astro";
import { APP_NAME } from "~/config";
import { listTokens } from "~/lib/api-tokens";
import { formatDateTime } from "~/lib/format";
import { PERMISSIONS, can } from "~/lib/permissions";
import "~/styles/horas.css";

export const prerender = false;

const ws = Astro.locals.membership!;
const tokens = await listTokens(Astro.locals.env, {
  userId: Astro.locals.user!.id,
  workspaceId: ws.workspaceId,
});
const origin = Astro.url.origin;
const mcpName = APP_NAME.toLowerCase();
const readOnly = !can(ws.role, PERMISSIONS.CONTENT_WRITE);

const examples = [
  {
    id: "ex-claude-code",
    title: "Claude Code",
    note: "Run it in the terminal.",
    code: `claude mcp add --transport http ${mcpName} ${origin}/mcp --header "Authorization: Bearer YOUR_TOKEN"`,
  },
  {
    id: "ex-url",
    title: "Claude (custom connector) and other clients that only accept a URL",
    note: "In Settings → Connectors → Add custom connector, paste this URL. The token is part of the URL itself, so treat it like a password.",
    code: `${origin}/mcp/YOUR_TOKEN`,
  },
  {
    id: "ex-json",
    title: "Cursor, VS Code and clients with a config file",
    note: "Standard mcpServers format.",
    code: JSON.stringify(
      { mcpServers: { [mcpName]: { url: `${origin}/mcp`, headers: { Authorization: "Bearer YOUR_TOKEN" } } } },
      null,
      2,
    ),
  },
  {
    id: "ex-curl",
    title: "REST API",
    note: "For scripts and automations. Routes: /status, /entries, /timer/start, /timer/stop, /projects, /summary, /export.csv.",
    code: `curl ${origin}/api/v1/status -H "Authorization: Bearer YOUR_TOKEN"\n\ncurl -X POST ${origin}/api/v1/timer/start \\\n  -H "Authorization: Bearer YOUR_TOKEN" -H "Content-Type: application/json" \\\n  -d '{"description": "Kickoff meeting", "project": "Client X"}'`,
  },
];
---

<Dashboard
  title={`Integrations — ${ws.workspaceName}`}
  heading="API & MCP"
  description="Connect Claude or another AI to start timers, log hours and pull reports for you."
>
  <div id="horas-app" data-view="integrations" data-tokens={`/api/w/${ws.workspaceSlug}/tokens`}>
    {readOnly && (
      <p class="alert alert-info">
        <span>Your role here is read-only: a token of yours can query, but not log hours.</span>
      </p>
    )}

    <div class="card">
      <h2>New token</h2>
      <span class="muted">
        Each token works for you in this workspace. Create one per app — that way you can revoke one without taking down the others.
      </span>
      <form id="new-token" class="row">
        <div class="field">
          <label for="name">Where you'll use it</label>
          <input id="name" name="name" type="text" maxlength="60" placeholder="E.g. Claude on my laptop" required />
        </div>
        <div class="field hr-field-btn"><button type="submit">Generate token</button></div>
      </form>
      <div id="token-reveal" class="alert hr-reveal" hidden>
        <div>
          <strong>Copy it now — it won't be shown again.</strong>
          <code id="token-value"></code>
          <button type="button" class="btn-sm" data-copy="token-value">Copy token</button>
          <small class="muted"> The examples below are already filled in with it.</small>
        </div>
      </div>
    </div>

    <div class="card">
      <h2>Your tokens ({tokens.length})</h2>
      {tokens.length === 0 ? (
        <p class="empty">No tokens yet.</p>
      ) : (
        <div class="table-wrap">
          <table>
            <thead><tr><th>Name</th><th>Token</th><th>Timezone</th><th>Created</th><th>Last used</th><th></th></tr></thead>
            <tbody>
              {tokens.map((t) => (
                <tr>
                  <td class="wrap"><strong>{t.name}</strong></td>
                  <td><code>{t.prefix}…</code></td>
                  <td>{t.timezone}</td>
                  <td>{formatDateTime(new Date(t.createdAt))}</td>
                  <td>{t.lastUsedAt ? formatDateTime(new Date(t.lastUsedAt)) : "never"}</td>
                  <td><button type="button" class="btn-danger btn-sm" data-revoke={t.id}>Revoke</button></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>

    <div class="card">
      <h2>How to connect</h2>
      <span class="muted">
        The MCP server lives at <code>{origin}/mcp</code>. Once connected, try asking:
        “start a timer for the site review on project Acme” or “how much did I work this week?”.
      </span>
      {examples.map((ex) => (
        <div class="hr-code">
          <p style="margin: 16px 0 0"><strong>{ex.title}</strong><br /><small class="muted">{ex.note}</small></p>
          <pre id={ex.id} data-token>{ex.code}</pre>
          <button type="button" class="btn-ghost btn-sm" data-copy={ex.id}>Copy</button>
        </div>
      ))}
    </div>
  </div>
  <script is:inline src="/app/horas.js" defer></script>
</Dashboard>
