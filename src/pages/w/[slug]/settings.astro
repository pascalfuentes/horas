---
import Dashboard from "~/layouts/Dashboard.astro";
import { countOwners } from "~/lib/members";
import { PERMISSIONS, can } from "~/lib/permissions";

export const prerender = false;

const ws = Astro.locals.membership!;
if (!can(ws.role, PERMISSIONS.WORKSPACE_READ)) {
  return Astro.redirect(`/w/${ws.workspaceSlug}?e=no_permission`);
}

const canEdit = can(ws.role, PERMISSIONS.WORKSPACE_WRITE);
const canDelete = can(ws.role, PERMISSIONS.WORKSPACE_DELETE);
const isSoleOwner = ws.role === "owner" && (await countOwners(Astro.locals.env, ws.workspaceId)) === 1;
---

<Dashboard title={`Settings — ${ws.workspaceName}`} heading="Settings" description={`/w/${ws.workspaceSlug}`}>
  <div class="card">
    <h2>Name</h2>
    <span class="muted">
      The address (<code>/w/{ws.workspaceSlug}</code>) does not change with it: changing it would break
      every link already shared for this workspace, including those in emails.
    </span>

    {canEdit ? (
      <form method="post" action={`/api/w/${ws.workspaceSlug}/workspace`} class="row">
        <input type="hidden" name="action" value="rename" />
        <div class="field">
          <label for="name">Workspace name</label>
          <input id="name" name="name" type="text" value={ws.workspaceName} maxlength="60" required />
        </div>
        <div><button type="submit">Save</button></div>
      </form>
    ) : (
      <p class="muted">Your role here does not allow changing the settings.</p>
    )}
  </div>

  <div class="card">
    <h2>Leave this workspace</h2>
    <span class="muted">
      You lose access to its content. To come back, someone has to invite you again.
    </span>

    {isSoleOwner ? (
      <p class="alert alert-info">
        <span>
          You are the only owner here. Transfer ownership to someone else in{" "}
          <a href={`/w/${ws.workspaceSlug}/members`}>Members</a> before leaving — otherwise the
          workspace would be left without an owner.
        </span>
      </p>
    ) : (
      <form method="post" action={`/api/w/${ws.workspaceSlug}/members`} class="inline-form">
        <input type="hidden" name="action" value="leave" />
        <button class="btn-danger btn-sm" type="submit">Leave workspace</button>
      </form>
    )}
  </div>

  {canDelete && (
    <div class="card">
      <h2>Delete workspace</h2>
      <span class="muted">
        Deletes everyone's content, invites and membership. <strong>This cannot be undone.</strong>{" "}
        The audit trail stays, recording that it existed and who did what in it.
      </span>

      <form method="post" action={`/api/w/${ws.workspaceSlug}/workspace`} class="stack" style="max-width:520px">
        <input type="hidden" name="action" value="delete" />
        <div class="field">
          <label for="confirmation">Type <strong>{ws.workspaceName}</strong> to confirm</label>
          <input id="confirmation" name="confirmation" type="text" autocomplete="off" required />
        </div>
        <div><button class="btn-danger" type="submit">Delete permanently</button></div>
      </form>
    </div>
  )}
</Dashboard>
