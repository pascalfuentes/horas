---
import Dashboard from "~/layouts/Dashboard.astro";
import { PERMISSIONS, pode } from "~/lib/permissions";
import "~/styles/horas.css";

export const prerender = false;

const ws = Astro.locals.membership!;
const titulo = `Relatórios — ${ws.workspaceNome}`;
---

<Dashboard title={titulo} heading="Relatórios" description="Para onde foi o seu tempo.">
  <div
    id="horas-app"
    data-view="relatorios"
    data-title={titulo}
    data-base={`/api/w/${ws.workspaceSlug}/horas`}
    data-write={pode(ws.role, PERMISSIONS.CONTENT_WRITE) ? "1" : "0"}
  >
    <p class="muted">Carregando…</p>
  </div>
  <noscript><p class="alert alert-error">Esta tela precisa de JavaScript.</p></noscript>
  <script is:inline src="/app/horas.js" defer></script>
</Dashboard>
