---
import Dashboard from "~/layouts/Dashboard.astro";
import { WORKSPACE_ROLES, type WorkspaceRole } from "~/db/schema";
import { formatDateTime } from "~/lib/format";
import { listInvites, listMembers, inviteStatus } from "~/lib/members";
import { PERMISSIONS, ROLE_DESCRIPTIONS, ROLE_LABELS, can } from "~/lib/permissions";

export const prerender = false;

const ws = Astro.locals.membership!;
const me = Astro.locals.user!;

if (!can(ws.role, PERMISSIONS.MEMBERS_READ)) {
  return Astro.redirect(`/w/${ws.workspaceSlug}?e=no_permission`);
}

const canManage = can(ws.role, PERMISSIONS.MEMBERS_WRITE);
const canTransfer = can(ws.role, PERMISSIONS.WORKSPACE_TRANSFER);

const members = await listMembers(Astro.locals.env, ws.workspaceId);
const invites = await listInvites(Astro.locals.env, ws.workspaceId);
const pending = invites.filter((c) => inviteStatus(c) === "pending");
const myMembership = members.find((m) => m.userId === me.id);

// It only makes sense to invite to roles that can be assigned. `owner` stays
// out: one becomes owner by transfer, a deliberate action by someone who already is.
const invitableRoles = WORKSPACE_ROLES.filter((r) => r !== "owner");
---

<Dashboard
  title={`Members — ${ws.workspaceName}`}
  heading="Members"
  description={`${members.length} ${members.length === 1 ? "person" : "people"} · ${pending.length} pending invite${pending.length === 1 ? "" : "s"}`}
>
  {canManage && (
    <div class="card">
      <h2>Invite</h2>
      <span class="muted">
        The person gets a link. If they don't have an account yet, they create one with that same email —
        the invite is only valid for the address that received it.
      </span>

      <form method="post" action={`/api/w/${ws.workspaceSlug}/invites`} class="row">
        <input type="hidden" name="action" value="invite" />
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required />
        </div>
        <div class="field" style="flex:0 1 180px">
          <label for="role">Role</label>
          <select id="role" name="role">
            {invitableRoles.map((r) => (
              <option value={r} selected={r === "editor"}>{ROLE_LABELS[r as WorkspaceRole]}</option>
            ))}
          </select>
        </div>
        <div><button type="submit">Send invite</button></div>
      </form>
      <span class="hint muted"><small>{ROLE_DESCRIPTIONS.editor}</small></span>
    </div>
  )}

  <div class="card">
    <h2>People in this workspace</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Person</th><th>Role</th><th>Since</th>{canManage && <th>Actions</th>}</tr></thead>
        <tbody>
          {members.map((m) => (
            <tr>
              <td class="wrap">
                <strong>{m.name}</strong><br /><small class="muted">{m.email}</small>
                {m.userId === me.id && <> <span class="badge">you</span></>}
              </td>
              <td>
                {canManage && m.role !== "owner" && m.userId !== me.id ? (
                  <form method="post" action={`/api/w/${ws.workspaceSlug}/members`} class="inline-form">
                    <input type="hidden" name="action" value="role" />
                    <input type="hidden" name="memberId" value={m.memberId} />
                    <select name="role">
                      {invitableRoles.map((r) => (
                        <option value={r} selected={r === m.role}>{ROLE_LABELS[r as WorkspaceRole]}</option>
                      ))}
                    </select>
                    <button class="btn-ghost btn-sm" type="submit">Apply</button>
                  </form>
                ) : (
                  <span class={`badge ${m.role === "owner" ? "badge-admin" : ""}`}>{ROLE_LABELS[m.role]}</span>
                )}
              </td>
              <td>{formatDateTime(m.since)}</td>
              {canManage && (
                <td>
                  <div class="row-actions">
                    {m.userId !== me.id && m.role !== "owner" && (
                      <form method="post" action={`/api/w/${ws.workspaceSlug}/members`} class="inline-form">
                        <input type="hidden" name="action" value="remove" />
                        <input type="hidden" name="memberId" value={m.memberId} />
                        <button class="btn-danger btn-sm" type="submit">Remove</button>
                      </form>
                    )}
                    {canTransfer && m.userId !== me.id && myMembership && (
                      <form method="post" action={`/api/w/${ws.workspaceSlug}/members`} class="inline-form">
                        <input type="hidden" name="action" value="transfer" />
                        <input type="hidden" name="memberId" value={m.memberId} />
                        <input type="hidden" name="myMemberId" value={myMembership.memberId} />
                        <button class="btn-ghost btn-sm" type="submit"
                                title="You become an admin and this person becomes the owner">
                          Make owner
                        </button>
                      </form>
                    )}
                  </div>
                </td>
              )}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <h2>Invites ({pending.length} pending)</h2>
    {invites.length === 0 ? (
      <p class="empty">No invites yet.</p>
    ) : (
      <div class="table-wrap">
        <table>
          <thead><tr><th>Email</th><th>Role</th><th>Status</th><th>Invited by</th><th>Expires</th>{canManage && <th>Actions</th>}</tr></thead>
          <tbody>
            {invites.map((c) => {
              const status = inviteStatus(c);
              return (
                <tr>
                  <td class="wrap">{c.email}</td>
                  <td><span class="badge">{c.role ? ROLE_LABELS[c.role] : "—"}</span></td>
                  <td><span class={`badge ${status === "accepted" ? "badge-ok" : ""}`}>{status}</span></td>
                  <td class="wrap">{c.invitedBy ?? "—"}</td>
                  <td>{formatDateTime(c.expiresAt)}</td>
                  {canManage && (
                    <td>
                      {status === "pending" || status === "expired" ? (
                        <div class="row-actions">
                          <form method="post" action={`/api/w/${ws.workspaceSlug}/invites`} class="inline-form">
                            <input type="hidden" name="action" value="resend" />
                            <input type="hidden" name="email" value={c.email} />
                            <input type="hidden" name="role" value={c.role ?? "viewer"} />
                            <button class="btn-ghost btn-sm" type="submit">Resend</button>
                          </form>
                          {status === "pending" && (
                            <form method="post" action={`/api/w/${ws.workspaceSlug}/invites`} class="inline-form">
                              <input type="hidden" name="action" value="cancel" />
                              <input type="hidden" name="id" value={c.id} />
                              <input type="hidden" name="email" value={c.email} />
                              <button class="btn-danger btn-sm" type="submit">Cancel</button>
                            </form>
                          )}
                        </div>
                      ) : (
                        <span class="muted">—</span>
                      )}
                    </td>
                  )}
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}
  </div>
</Dashboard>
