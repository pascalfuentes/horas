---
import Dashboard from "~/layouts/Dashboard.astro";
import { PERMISSIONS, can } from "~/lib/permissions";
import "~/styles/horas.css";

export const prerender = false;

const ws = Astro.locals.membership!;
const titulo = `Tempo — ${ws.workspaceName}`;
---

<Dashboard title={titulo} heading="Tempo" description="Seu timer e os lançamentos dos últimos 30 dias.">
  <div
    id="horas-app"
    data-view="time"
    data-title={titulo}
    data-base={`/api/w/${ws.workspaceSlug}/horas`}
    data-write={can(ws.role, PERMISSIONS.CONTENT_WRITE) ? "1" : "0"}
  >
    <p class="muted">Carregando…</p>
  </div>
  <noscript><p class="alert alert-error">Esta tela precisa de JavaScript.</p></noscript>
  <script is:inline src="/app/horas.js" defer></script>
</Dashboard>
