---
import ErrorScreen from "~/layouts/ErrorScreen.astro";
export const prerender = false;

/**
 * Astro passes the error in `Astro.props.error`. It does NOT go to the screen:
 * internal error messages tend to reveal file paths, table names and library
 * versions — free information for anyone probing.
 */
const { error } = Astro.props;
if (error) console.error("Unhandled error:", error);
---
<ErrorScreen code="500" title="Something went wrong" heading="Something went wrong" lead="We lost track of time for a moment. The failure was logged on our side.">
  <p>
    Try again in a moment. If it keeps happening, let an administrator know — the exact time
    helps find the log entry.
  </p>
  <Fragment slot="actions">
    <a class="btn" href="/dashboard">Try again</a>
    <a class="btn btn-ghost" href="/">Back to the home page</a>
  </Fragment>
</ErrorScreen>
