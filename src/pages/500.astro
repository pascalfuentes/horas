---
import Auth from "~/layouts/Auth.astro";
export const prerender = false;

/**
 * O Astro passa o erro em `Astro.props.error`. Ele NÃO vai para a tela:
 * mensagem de erro interna costuma revelar caminho de arquivo, nome de tabela
 * e versão de biblioteca — informação gratuita para quem estiver sondando.
 */
const { error } = Astro.props;
if (error) console.error("Erro não tratado:", error);
---
<Auth title="Algo deu errado" heading="Algo deu errado" subheading="A falha foi registrada do nosso lado.">
  <p class="muted">
    Tente de novo em instantes. Se continuar acontecendo, avise um administrador — o horário exato
    ajuda a encontrar o registro.
  </p>
  <a class="btn btn-block" href="/login">Voltar ao início</a>
</Auth>
