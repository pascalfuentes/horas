---
import { eq } from "drizzle-orm";

import Auth from "~/layouts/Auth.astro";
import { organization, orgInvitation } from "~/db/schema";
import { getDb } from "~/lib/auth";
import { ROLE_LABELS } from "~/lib/permissions";

export const prerender = false;

/**
 * Página de aceite. Pública de propósito: quem ainda não tem conta precisa
 * chegar aqui, entender o que é, e criar a conta com o e-mail certo.
 *
 * O que ela mostra é o nome do workspace e o e-mail convidado — informação que
 * quem tem o link já recebeu no próprio e-mail. O id é um UUID, então segue a
 * mesma lógica de um token: só chega aqui quem recebeu.
 *
 * O aceite em si é que tem as travas, e são do plugin: e-mail da sessão igual
 * ao do convite, e e-mail verificado.
 */
const id = Astro.params.id ?? "";

const convite = await getDb(Astro.locals.env)
  .select({
    id: orgInvitation.id,
    email: orgInvitation.email,
    role: orgInvitation.role,
    status: orgInvitation.status,
    expiraEm: orgInvitation.expiresAt,
    workspace: organization.name,
  })
  .from(orgInvitation)
  .innerJoin(organization, eq(organization.id, orgInvitation.organizationId))
  .where(eq(orgInvitation.id, id))
  .get();

const valido =
  convite && convite.status === "pending" && convite.expiraEm.getTime() > Date.now();

const eu = Astro.locals.user;
const emailConfere = eu && convite && eu.email.toLowerCase() === convite.email.toLowerCase();
const precisaVerificar = eu && emailConfere && !eu.emailVerified;
---

<Auth
  title="Convite"
  heading={valido ? `Convite para ${convite!.workspace}` : "Convite indisponível"}
  subheading={valido ? `Como ${ROLE_LABELS[convite!.role ?? "viewer"]}` : undefined}
>
  {!valido ? (
    <>
      <p class="alert alert-error">
        Este convite é inválido, já foi usado, foi cancelado ou expirou. Peça outro a quem
        administra o workspace.
      </p>
      <a class="btn btn-block btn-ghost" href="/login">Ir para o login</a>
    </>
  ) : !eu ? (
    <>
      <p class="muted">
        O convite é para <strong>{convite!.email}</strong>. Entre com essa conta, ou crie uma
        com esse mesmo e-mail — o convite só vale para o endereço que o recebeu.
      </p>
      <div class="stack">
        <a class="btn btn-block" href={`/login?next=${encodeURIComponent(`/invite/${id}`)}`}>Entrar</a>
        <a class="btn btn-block btn-ghost" href="/signup">Criar conta</a>
      </div>
    </>
  ) : !emailConfere ? (
    <>
      <p class="alert alert-error">
        Este convite é para <strong>{convite!.email}</strong>, e você está como
        <strong> {eu.email}</strong>. Saia e entre com a conta certa.
      </p>
      <form method="post" action="/api/logout"><button class="btn-block btn-ghost" type="submit">Sair</button></form>
    </>
  ) : precisaVerificar ? (
    <>
      <p class="alert alert-info">
        <span>Confirme seu e-mail antes de aceitar. Sem isso, bastaria cadastrar-se com o
        endereço de um convidado para herdar o convite dele.</span>
      </p>
      <a class="btn btn-block" href="/verify-email">Confirmar e-mail</a>
    </>
  ) : (
    <div class="stack">
      <form method="post" action="/api/invite/accept">
        <input type="hidden" name="id" value={id} />
        <button class="btn-block" type="submit">Entrar no workspace</button>
      </form>
      <form method="post" action="/api/invite/accept">
        <input type="hidden" name="id" value={id} />
        <input type="hidden" name="action" value="decline" />
        <button class="btn-block btn-ghost" type="submit">Recusar</button>
      </form>
    </div>
  )}
</Auth>
