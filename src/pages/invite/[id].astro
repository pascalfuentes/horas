---
import { eq } from "drizzle-orm";

import Auth from "~/layouts/Auth.astro";
import { organization, orgInvitation } from "~/db/schema";
import { getDb } from "~/lib/auth";
import { ROLE_LABELS } from "~/lib/permissions";

export const prerender = false;

/**
 * Acceptance page. Public on purpose: someone who has no account yet needs to
 * get here, understand what it is, and create the account with the right email.
 *
 * What it shows is the workspace name and the invited email — information the
 * holder of the link already received in the email itself. The id is a UUID,
 * so it follows the same logic as a token: only whoever received it gets here.
 *
 * The acceptance itself is what has the locks, and they belong to the plugin:
 * session email equal to the invite's, and a verified email.
 */
const id = Astro.params.id ?? "";

const invite = await getDb(Astro.locals.env)
  .select({
    id: orgInvitation.id,
    email: orgInvitation.email,
    role: orgInvitation.role,
    status: orgInvitation.status,
    expiresAt: orgInvitation.expiresAt,
    workspace: organization.name,
  })
  .from(orgInvitation)
  .innerJoin(organization, eq(organization.id, orgInvitation.organizationId))
  .where(eq(orgInvitation.id, id))
  .get();

const valid =
  invite && invite.status === "pending" && invite.expiresAt.getTime() > Date.now();

const me = Astro.locals.user;
const emailMatches = me && invite && me.email.toLowerCase() === invite.email.toLowerCase();
const needsVerification = me && emailMatches && !me.emailVerified;
---

<Auth
  title="Invite"
  heading={valid ? `Invite to ${invite!.workspace}` : "Invite unavailable"}
  subheading={valid ? `As ${ROLE_LABELS[invite!.role ?? "viewer"]}` : undefined}
>
  {!valid ? (
    <>
      <p class="alert alert-error">
        This invite is invalid, has already been used, was canceled or has expired. Ask whoever
        administers the workspace for another one.
      </p>
      <a class="btn btn-block btn-ghost" href="/login">Go to login</a>
    </>
  ) : !me ? (
    <>
      <p class="muted">
        The invite is for <strong>{invite!.email}</strong>. Log in with that account, or create one
        with that same email — the invite is only valid for the address that received it.
      </p>
      <div class="stack">
        <a class="btn btn-block" href={`/login?next=${encodeURIComponent(`/invite/${id}`)}`}>Log in</a>
        <a class="btn btn-block btn-ghost" href="/signup">Create account</a>
      </div>
    </>
  ) : !emailMatches ? (
    <>
      <p class="alert alert-error">
        This invite is for <strong>{invite!.email}</strong>, and you are logged in as
        <strong> {me.email}</strong>. Log out and log in with the right account.
      </p>
      <form method="post" action="/api/logout"><button class="btn-block btn-ghost" type="submit">Log out</button></form>
    </>
  ) : needsVerification ? (
    <>
      <p class="alert alert-info">
        <span>Confirm your email before accepting. Without that, signing up with an
        invitee's address would be enough to inherit their invite.</span>
      </p>
      <a class="btn btn-block" href="/verify-email">Confirm email</a>
    </>
  ) : (
    <div class="stack">
      <form method="post" action="/api/invite/accept">
        <input type="hidden" name="id" value={id} />
        <button class="btn-block" type="submit">Join workspace</button>
      </form>
      <form method="post" action="/api/invite/accept">
        <input type="hidden" name="id" value={id} />
        <input type="hidden" name="action" value="decline" />
        <button class="btn-block btn-ghost" type="submit">Decline</button>
      </form>
    </div>
  )}
</Auth>
