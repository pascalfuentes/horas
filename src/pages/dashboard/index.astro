---
import { userWorkspaces } from "~/lib/workspaces";

export const prerender = false;

/**
 * `/dashboard` has no content of its own: it decides where the person goes.
 *
 * It uses the session's `activeOrganizationId` — which exists exactly for this,
 * remembering the last workspace used. If it is no longer valid (the person
 * left the workspace, or it was deleted), it falls back to the first in the list.
 */
const mine = await userWorkspaces(Astro.locals.env, Astro.locals.user!.id);
const last = Astro.locals.session?.activeOrganizationId;

const slug = mine.find((w) => w.workspaceId === last)?.workspaceSlug ?? mine[0]?.workspaceSlug;
const destination = slug ? `/w/${slug}/time` : "/workspaces";

// The notice has to survive the hop. Whoever accepts an invite passes through
// here on the way to the new workspace, and without this the confirmation got
// lost along the way — the person was teleported somewhere else with no
// explanation at all.
// Only `ok` and `e` go forward; forwarding the whole query would carry into the
// dashboard anything someone hung on the URL.
const notices = new URLSearchParams();
for (const key of ["ok", "e"] as const) {
  const value = Astro.url.searchParams.get(key);
  if (value) notices.set(key, value);
}

const query = notices.toString();
return Astro.redirect(query ? `${destination}?${query}` : destination);
---
