---
import { workspacesDoUsuario } from "~/lib/workspaces";

export const prerender = false;

/**
 * `/dashboard` não tem conteúdo próprio: ele decide para onde a pessoa vai.
 *
 * Usa o `activeOrganizationId` da sessão — que serve exatamente para isto,
 * lembrar o último workspace usado. Se ele não valer mais (a pessoa saiu do
 * workspace, ou ele foi excluído), cai no primeiro da lista.
 */
const meus = await workspacesDoUsuario(Astro.locals.env, Astro.locals.user!.id);
const ultimo = Astro.locals.session?.activeOrganizationId;

const slug = meus.find((w) => w.workspaceId === ultimo)?.workspaceSlug ?? meus[0]?.workspaceSlug;
const destino = slug ? `/w/${slug}/tempo` : "/workspaces";

// O aviso precisa sobreviver ao salto. Quem aceita um convite passa por aqui a
// caminho do workspace novo, e sem isso a confirmação se perdia no caminho —
// a pessoa era teleportada para outro lugar sem nenhuma explicação.
// Só `ok` e `e` seguem adiante; repassar o query inteiro seria carregar para
// dentro do painel qualquer coisa que alguém pendurasse na URL.
const avisos = new URLSearchParams();
for (const chave of ["ok", "e"] as const) {
  const valor = Astro.url.searchParams.get(chave);
  if (valor) avisos.set(chave, valor);
}

const query = avisos.toString();
return Astro.redirect(query ? `${destino}?${query}` : destino);
---
