---
import Dashboard from "~/layouts/Dashboard.astro";

export const prerender = false;

const user = Astro.locals.user! as typeof Astro.locals.user & { phone?: string | null };
---

<Dashboard title="My details" heading="My details" description="Update your personal information.">
  <div class="card">
    <h2>Personal information</h2>
    <span class="muted">The email is changed in the Security tab, with confirmation.</span>

    <form method="post" action="/api/profile" class="stack">
      <div class="field">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" value={user.name} autocomplete="name" required />
      </div>

      <div class="field">
        <label for="phone">Phone</label>
        <input id="phone" name="phone" type="tel" value={user.phone ?? ""} autocomplete="tel" />
        <span class="hint">Optional.</span>
      </div>

      <div class="field">
        <label for="email">Email</label>
        <input id="email" type="email" value={user.email} disabled />
        <span class="hint"><a href="/dashboard/security">Change email</a></span>
      </div>

      <div><button type="submit">Save changes</button></div>
    </form>
  </div>
</Dashboard>
