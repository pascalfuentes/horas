---
import Dashboard from "~/layouts/Dashboard.astro";

export const prerender = false;

const user = Astro.locals.user! as typeof Astro.locals.user & { phone?: string | null };
---

<Dashboard title="Meus dados" heading="Meus dados" description="Atualize suas informações pessoais.">
  <div class="card">
    <h2>Informações pessoais</h2>
    <span class="muted">O e-mail é alterado na aba Segurança, com confirmação.</span>

    <form method="post" action="/api/profile" class="stack">
      <div class="field">
        <label for="nome">Nome</label>
        <input id="nome" name="name" type="text" value={user.name} autocomplete="name" required />
      </div>

      <div class="field">
        <label for="telefone">Telefone</label>
        <input id="telefone" name="phone" type="tel" value={user.phone ?? ""} autocomplete="tel" />
        <span class="hint">Opcional.</span>
      </div>

      <div class="field">
        <label for="email">E-mail</label>
        <input id="email" type="email" value={user.email} disabled />
        <span class="hint"><a href="/dashboard/security">Trocar e-mail</a></span>
      </div>

      <div><button type="submit">Salvar alterações</button></div>
    </form>
  </div>
</Dashboard>
