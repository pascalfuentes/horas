---
import { desc } from "drizzle-orm";

import Dashboard from "~/layouts/Dashboard.astro";
import { PLATFORM_ROLES, user as userTable, type PlatformRole } from "~/db/schema";
import { getDb } from "~/lib/auth";
import { formatDateTime } from "~/lib/format";
import { PLATFORM_ROLE_LABELS } from "~/lib/permissions";

export const prerender = false;

const db = getDb(Astro.locals.env);
const me = Astro.locals.user!;

const users = await db
  .select({
    id: userTable.id,
    name: userTable.name,
    email: userTable.email,
    role: userTable.role,
    banned: userTable.banned,
    twoFactorEnabled: userTable.twoFactorEnabled,
    createdAt: userTable.createdAt,
  })
  .from(userTable)
  .orderBy(desc(userTable.createdAt))
  .limit(500)
  .all();

// For the interface only — the real guarantee is the trigger in
// migrations/0001_invariants.sql, which aborts the transaction.
const activeAdmins = users.filter((u) => u.role === "admin" && !u.banned).length;
const isLastAdmin = (u: (typeof users)[number]) =>
  u.role === "admin" && !u.banned && activeAdmins === 1;
---

<Dashboard
  title="Users"
  heading="Users"
  description={`${users.length} account${users.length === 1 ? "" : "s"} · ${activeAdmins} active admin${activeAdmins === 1 ? "" : "s"}`}
>
  {activeAdmins === 1 && (
    <p class="alert alert-info">
      <span>
        There is only one active administrator. The database does not allow demoting or
        disabling them — promote someone else first.
      </span>
    </p>
  )}

  <div class="card">
    <h2>Accounts</h2>
    <span class="muted">
      Disabling preserves the history; it is preferable to deleting. "Unlock" removes two-step
      verification for someone who lost their phone <em>and</em> the recovery codes — the person
      logs in with just the password again and sets it up anew.
    </span>

    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Person</th><th>Role</th><th>Status</th><th>2FA</th><th>Created</th><th>Actions</th></tr>
        </thead>
        <tbody>
          {users.map((u) => (
            <tr>
              <td class="wrap">
                <strong>{u.name}</strong><br />
                <small class="muted">{u.email}</small>
                {u.id === me.id && <> <span class="badge">you</span></>}
              </td>

              <td>
                <form method="post" action="/api/admin/users" class="inline-form">
                  <input type="hidden" name="action" value="role" />
                  <input type="hidden" name="userId" value={u.id} />
                  <input type="hidden" name="email" value={u.email} />
                  <select name="role" disabled={u.id === me.id || isLastAdmin(u)}>
                    {PLATFORM_ROLES.map((r) => (
                      <option value={r} selected={r === u.role}>{PLATFORM_ROLE_LABELS[r]}</option>
                    ))}
                  </select>
                  <button class="btn-ghost btn-sm" type="submit" disabled={u.id === me.id || isLastAdmin(u)}>
                    Apply
                  </button>
                </form>
              </td>

              <td>
                {u.banned
                  ? <span class="badge">disabled</span>
                  : <span class="badge badge-ok">active</span>}
              </td>

              <td>
                {u.twoFactorEnabled ? (
                  <form method="post" action="/api/admin/users" class="inline-form">
                    <input type="hidden" name="action" value="reset-2fa" />
                    <input type="hidden" name="userId" value={u.id} />
                    <input type="hidden" name="email" value={u.email} />
                    <span class="badge badge-ok">active</span>
                    <button class="btn-danger btn-sm" type="submit"
                            title="Use when the person loses their phone and the recovery codes">
                      Unlock
                    </button>
                  </form>
                ) : (
                  <span class="badge">no</span>
                )}
              </td>

              <td>{formatDateTime(u.createdAt)}</td>

              <td>
                <div class="row-actions">
                  {u.banned ? (
                    <form method="post" action="/api/admin/users" class="inline-form">
                      <input type="hidden" name="action" value="enable" />
                      <input type="hidden" name="userId" value={u.id} />
                      <input type="hidden" name="email" value={u.email} />
                      <button class="btn-ghost btn-sm" type="submit">Re-enable</button>
                    </form>
                  ) : (
                    <form method="post" action="/api/admin/users" class="inline-form">
                      <input type="hidden" name="action" value="disable" />
                      <input type="hidden" name="userId" value={u.id} />
                      <input type="hidden" name="email" value={u.email} />
                      <button class="btn-danger btn-sm" type="submit" disabled={u.id === me.id || isLastAdmin(u)}>
                        Disable
                      </button>
                    </form>
                  )}

                  <form method="post" action="/api/admin/users" class="inline-form">
                    <input type="hidden" name="action" value="revoke-sessions" />
                    <input type="hidden" name="userId" value={u.id} />
                    <input type="hidden" name="email" value={u.email} />
                    <button class="btn-ghost btn-sm" type="submit">End sessions</button>
                  </form>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</Dashboard>
