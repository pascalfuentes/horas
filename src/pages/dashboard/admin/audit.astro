---
import { desc } from "drizzle-orm";

import Dashboard from "~/layouts/Dashboard.astro";
import { auditLog } from "~/db/schema";
import { AUDIT_LABELS, type AuditAction } from "~/lib/audit";
import { getDb } from "~/lib/auth";
import { formatDateTime } from "~/lib/format";

export const prerender = false;

const events = await getDb(Astro.locals.env)
  .select()
  .from(auditLog)
  .orderBy(desc(auditLog.createdAt))
  .limit(200)
  .all();

const describe = (action: string) => AUDIT_LABELS[action as AuditAction] ?? action;
---

<Dashboard
  title="Audit log"
  heading="Audit log"
  description="Who did what, to whom and when. Last 200 events."
>
  <div class="card">
    <h2>Events</h2>
    {events.length === 0 ? (
      <p class="empty">Nothing recorded yet.</p>
    ) : (
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>When</th><th>Who</th><th>What</th><th>Target</th><th>Details</th><th>IP</th></tr>
          </thead>
          <tbody>
            {events.map((e) => (
              <tr>
                <td>{formatDateTime(e.createdAt)}</td>
                <td class="wrap">{e.actorEmail ?? <span class="muted">system</span>}</td>
                <td class="wrap">{describe(e.action)}</td>
                <td class="wrap">{e.targetEmail ?? "—"}</td>
                <td class="wrap"><small class="muted">{e.details ?? "—"}</small></td>
                <td>{e.ip ?? "—"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</Dashboard>
