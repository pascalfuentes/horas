---
import Dashboard from "~/layouts/Dashboard.astro";
import { formatDateTime } from "~/lib/format";
import { REQUIRE_2FA_FOR_ADMINS } from "~/config";

export const prerender = false;

const user = Astro.locals.user!;
const current = Astro.locals.session!;

const twoFactorActive = Boolean((user as { twoFactorEnabled?: boolean }).twoFactorEnabled);
const enforced = REQUIRE_2FA_FOR_ADMINS && user.role === "admin";

const sessions = await Astro.locals.auth.api.listSessions({ headers: Astro.request.headers });
const sorted = [...sessions].sort((a, b) => b.createdAt.getTime() - a.createdAt.getTime());
---

<Dashboard title="Security" heading="Security" description="Password, email and connected devices.">
  <div class="card">
    <h2>Change password</h2>
    <span class="muted">When you change it, all other sessions are ended.</span>

    <form method="post" action="/api/security/password" class="stack">
      <div class="field">
        <label for="current">Current password</label>
        <input id="current" name="current_password" type="password" autocomplete="current-password" required />
      </div>
      <div class="row">
        <div class="field">
          <label for="new-password">New password</label>
          <input id="new-password" name="new_password" type="password" minlength="10" autocomplete="new-password" required />
        </div>
        <div class="field">
          <label for="confirm">Confirm new password</label>
          <input id="confirm" name="confirm" type="password" minlength="10" autocomplete="new-password" required />
        </div>
      </div>
      <div><button type="submit">Change password</button></div>
    </form>
  </div>

  <div class="card">
    <h2>
      Two-step verification
      {twoFactorActive
        ? <> <span class="badge badge-ok">on</span></>
        : <> <span class="badge">off</span></>}
    </h2>
    <span class="muted">
      {twoFactorActive
        ? "When you log in, we ask for a six-digit code from your authenticator app in addition to your password."
        : "A second proof beyond the password. If your password leaks on another site, it alone will not open this account."}
    </span>

    {twoFactorActive ? (
      <div class="row">
        <a class="btn btn-ghost" href="/dashboard/security/2fa">Generate new recovery codes</a>
        {!enforced && (
          <form method="post" action="/api/security/2fa" class="inline-form">
            <input type="hidden" name="action" value="disable" />
            <input name="password" type="password" placeholder="Your password" autocomplete="current-password" required />
            <button class="btn-danger btn-sm" type="submit">Disable</button>
          </form>
        )}
      </div>
    ) : (
      <a class="btn" href="/dashboard/security/2fa">Enable</a>
    )}

    {enforced && twoFactorActive && (
      <p class="muted" style="margin:14px 0 0">
        <small>
          Yours is an administrator account, so two-step verification is mandatory and cannot
          be disabled. To turn it off, change <code>REQUIRE_2FA_FOR_ADMINS</code> in{" "}
          <code>src/config.ts</code>.
        </small>
      </p>
    )}
  </div>

  <div class="card">
    <h2>Change email</h2>
    <span class="muted">
      We send a confirmation link to <strong>{user.email}</strong> — the current address.
      The change only happens after you click it.
    </span>

    <form method="post" action="/api/security/email" class="stack">
      <div class="field">
        <label for="email">New email</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
      </div>
      <div><button type="submit" class="btn-ghost">Request email change</button></div>
    </form>
  </div>

  <div class="card">
    <h2>Your data</h2>
    <span class="muted">
      The <a href="/privacy">privacy policy</a> explains what we store and why.
      Here you exercise the two rights it promises.
    </span>

    <div class="row">
      <a class="btn btn-ghost" href="/api/account/export" download>Download my data (JSON)</a>
    </div>
    <span class="hint muted">
      <small>
        Password, 2FA secret and recovery codes are not in the file — they are access
        credentials, not information about you, and exporting them would only create a new way to leak the account.
      </small>
    </span>
  </div>

  <div class="card">
    <h2>Delete my account</h2>
    <span class="muted">
      Deletes your account data, sessions and login methods. <strong>There is no going back.</strong>{" "}
      The audit trail is preserved in dissociated form: the action and the time remain,
      who did it does not — it exists for the security of everyone in the system.
    </span>

    <form method="post" action="/api/account/delete" class="stack" style="max-width:520px">
      <div class="field">
        <label for="confirmation">Type your email to confirm</label>
        <input id="confirmation" name="confirmation" type="text" autocomplete="off"
               placeholder={user.email} required />
      </div>
      <div class="field">
        <label for="delete-password">Your password</label>
        <input id="delete-password" name="password" type="password" autocomplete="current-password" required />
      </div>
      <div><button class="btn-danger" type="submit">Delete my account permanently</button></div>
    </form>

    {enforced && (
      <p class="muted" style="margin:14px 0 0">
        <small>
          If you are the only active administrator, the database does not allow deleting this
          account — promote someone else first.
        </small>
      </p>
    )}
  </div>

  <div class="card">
    <h2>Active sessions</h2>
    <span class="muted">Devices with access to your account right now.</span>

    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Device</th><th>IP</th><th>Started</th><th>Expires</th><th></th></tr>
        </thead>
        <tbody>
          {sorted.map((s) => (
            <tr>
              <td class="wrap">
                {s.userAgent ? s.userAgent.slice(0, 60) : "Unknown"}
                {s.token === current.token && <> <span class="badge badge-ok">this session</span></>}
              </td>
              <td>{s.ipAddress || "—"}</td>
              <td>{formatDateTime(s.createdAt)}</td>
              <td>{formatDateTime(s.expiresAt)}</td>
              <td>
                {s.token !== current.token && (
                  <form method="post" action="/api/security/session" class="inline-form">
                    <input type="hidden" name="token" value={s.token} />
                    <button class="btn-danger btn-sm" type="submit">End</button>
                  </form>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</Dashboard>
