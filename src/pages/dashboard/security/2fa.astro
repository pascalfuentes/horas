---
import { renderSVG } from "uqr";

import Dashboard from "~/layouts/Dashboard.astro";
import { APP_NAME } from "~/config";
import { callAuth } from "~/lib/auth";
import { str } from "~/lib/http";

export const prerender = false;

/**
 * 2FA setup — and, for those who already have it, generating new codes.
 *
 * The secret and the recovery codes are returned ONLY ONCE, in the Better Auth
 * response. Redirecting would lose them, and passing them through the
 * querystring would dump a secret into the browser history and the logs. That
 * is why the POST renders the page itself with the result instead of
 * redirecting.
 */

const mandatory = Astro.url.searchParams.has("required");
const alreadyActive = Boolean((Astro.locals.user as { twoFactorEnabled?: boolean }).twoFactorEnabled);

let error = "";
let totpURI = "";
let codes: string[] = [];

if (Astro.request.method === "POST") {
  const password = str(await Astro.request.formData(), "password");
  if (!password) {
    error = "Enter your password.";
  } else {
    try {
      const res = await callAuth(
        Astro.locals.auth,
        Astro.request,
        alreadyActive ? "/two-factor/generate-backup-codes" : "/two-factor/enable",
        alreadyActive ? { password: password } : { password: password, method: "totp" },
      );
      const body = (await res.json().catch(() => null)) as
        | { totpURI?: string; backupCodes?: string[] }
        | null;

      if (!res.ok) error = "Incorrect password.";
      else {
        totpURI = body?.totpURI ?? "";
        codes = body?.backupCodes ?? [];
      }
    } catch {
      error = "Could not continue. Try again.";
    }
  }
}

const secret = totpURI ? (new URL(totpURI).searchParams.get("secret") ?? "") : "";
/**
 * uqr emits the SVG with only `viewBox`, without `width`/`height` — under none
 * of its options. Inside a `width: max-content` container, an SVG with no
 * intrinsic size collapses to 0×0: the QR existed in the HTML and did not show
 * on screen. We inject the size into the tag itself, so the SVG does not
 * depend on any CSS.
 */
const qr = totpURI
  ? renderSVG(totpURI, { border: 1 }).replace(
      "<svg ",
      '<svg width="220" height="220" style="display:block" ',
    )
  : "";
const showingResult = codes.length > 0;
---

<Dashboard
  title="Two-step verification"
  heading={alreadyActive ? "New recovery codes" : "Two-step verification"}
  description={
    alreadyActive
      ? "Generating new codes invalidates all the old ones immediately."
      : "A six-digit code, in addition to your password, every time you log in."
  }
>
  {mandatory && !showingResult && (
    <p class="alert alert-info">
      <span>
        Yours is an administrator account, and administrators need two-step
        verification. You can browse normally again as soon as you finish this setup.
      </span>
    </p>
  )}

  {error && <p class="alert alert-error" role="alert">{error}</p>}

  {!showingResult && (
    <div class="card">
      <h2>{alreadyActive ? "Generate new codes" : "Enable"}</h2>
      <span class="muted">
        {alreadyActive
          ? "Use this if you have used up the old codes or think someone has seen them."
          : "You will need an authenticator app on your phone — Google Authenticator, Authy, 1Password or the password manager you already use."}
      </span>

      <form method="post" class="row">
        <div class="field">
          <label for="password">Confirm your password</label>
          <input id="password" name="password" type="password" autocomplete="current-password" required autofocus />
        </div>
        <div><button type="submit">Continue</button></div>
      </form>
      <span class="hint muted">
        <small>The password keeps someone from changing this in a session of yours left open.</small>
      </span>
    </div>
  )}

  {showingResult && totpURI && (
    <div class="card">
      <h2>1. Scan the code with your app</h2>
      <span class="muted">Add a new account in the authenticator app and point the camera.</span>

      <div style="background:#fff;padding:14px;border-radius:10px;width:max-content;margin:4px 0 14px">
        <Fragment set:html={qr} />
      </div>

      <p class="muted">
        <small>
          No camera? Add it manually as <strong>{APP_NAME}</strong> with this key:<br />
          <code>{secret}</code>
        </small>
      </p>
    </div>
  )}

  {showingResult && (
    <div class="card">
      <h2>{totpURI ? "2. Save the recovery codes" : "Your new codes"}</h2>
      <span class="muted">
        If you lose your phone, these are what get you back in — each one works only once.{" "}
        <strong>This is the only time they are shown.</strong> Save them in your password manager
        before leaving this screen.
      </span>
      <pre style="background:var(--surface-2);padding:14px;border-radius:10px;font-family:var(--mono);font-size:0.9rem;line-height:1.9;margin:0">{codes.join("\n")}</pre>
    </div>
  )}

  {showingResult && totpURI && (
    <div class="card">
      <h2>3. Confirm</h2>
      <span class="muted">
        Enter the code the app is showing now. Only after that does 2FA take effect — if the
        scan went wrong, you find out here, and not the next time you log in.
      </span>

      <form method="post" action="/api/security/2fa" class="row">
        <input type="hidden" name="action" value="confirm" />
        <div class="field">
          <label for="code">Six-digit code</label>
          <input id="code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code"
                 pattern="[0-9]{6}" maxlength="6" required autofocus />
        </div>
        <div><button type="submit">Enable two-step verification</button></div>
      </form>
    </div>
  )}

  {showingResult && !totpURI && (
    <a class="btn" href="/dashboard/security">I saved the codes, go back</a>
  )}
</Dashboard>
