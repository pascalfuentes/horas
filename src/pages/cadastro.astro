---
import BotoesSociais from "~/components/BotoesSociais.astro";
import Turnstile from "~/components/Turnstile.astro";
import Auth from "~/layouts/Auth.astro";

export const prerender = false;
---

<Auth
  title="Criar conta"
  heading="Criar conta"
  subheading="Você vai receber um e-mail para confirmar o endereço antes de entrar."
>
  <form method="post" action="/api/cadastro" class="stack">
    <div class="field">
      <label for="nome">Seu nome</label>
      <input id="nome" name="nome" type="text" autocomplete="name" required autofocus />
    </div>

    <div class="field">
      <label for="email">E-mail</label>
      <input id="email" name="email" type="email" autocomplete="username" required />
    </div>

    <div class="field">
      <label for="senha">Senha</label>
      <input id="senha" name="senha" type="password" minlength="10" autocomplete="new-password" required />
      <span class="hint">Mínimo de 10 caracteres.</span>
    </div>

    <div class="field">
      <label for="confirma">Confirmar senha</label>
      <input id="confirma" name="confirma" type="password" minlength="10" autocomplete="new-password" required />
    </div>

    <Turnstile />
    <button class="btn-block" type="submit">Criar conta</button>
  </form>

  <BotoesSociais verbo="Criar conta com" />

  <p class="auth-foot">Já tem conta? <a href="/login">Entrar</a></p>
  <p class="auth-foot muted">
    <small><a href="/privacidade">Política de privacidade</a></small>
  </p>
</Auth>
