---
import Auth from "~/layouts/Auth.astro";

export const prerender = false;

const token = Astro.url.searchParams.get("token") ?? "";
// Better Auth redirects here with `?error=...` when the token has already expired.
const brokenLink = !token || Astro.url.searchParams.has("error");
---

<Auth
  title="Set new password"
  heading="Set new password"
  subheading={brokenLink ? undefined : "Choose a password of at least 10 characters."}
>
  {brokenLink ? (
    <>
      <p class="alert alert-error">This link is invalid or has already expired.</p>
      <a class="btn btn-block" href="/forgot-password">Request a new link</a>
    </>
  ) : (
    <form method="post" action="/api/reset-password" class="stack">
      <input type="hidden" name="token" value={token} />
      <div class="field">
        <label for="password">New password</label>
        <input id="password" name="password" type="password" minlength="10" autocomplete="new-password" required autofocus />
        <span class="hint">At least 10 characters.</span>
      </div>
      <div class="field">
        <label for="confirm">Confirm new password</label>
        <input id="confirm" name="confirm" type="password" minlength="10" autocomplete="new-password" required />
      </div>
      <button class="btn-block" type="submit">Save new password</button>
    </form>
  )}
</Auth>
