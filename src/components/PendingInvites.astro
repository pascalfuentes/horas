---
import type { PendingInvite } from "~/lib/members";
import { ROLE_LABELS } from "~/lib/permissions";

interface Props {
  invites: PendingInvite[];
  /**
   * Without a confirmed email the plugin refuses the acceptance. Better not to
   * offer the button than to offer one that fails — the same choice as the
   * `/invite/[id]` page.
   */
  verified: boolean;
  /** How many to show before pointing to the full list. 0 = all. */
  limit?: number;
}

const { invites, verified, limit = 0 } = Astro.props;
const shown = limit > 0 ? invites.slice(0, limit) : invites;
const remaining = invites.length - shown.length;
---

{invites.length > 0 && (
  <div class="alert alert-info invites" role="status">
    <strong>
      {invites.length === 1
        ? "You have an invite waiting"
        : `You have ${invites.length} invites waiting`}
    </strong>

    {!verified && (
      <p class="muted">
        <small>
          Confirm your email to be able to accept. <a href="/verify-email">Confirm now</a>
        </small>
      </p>
    )}

    <ul>
      {shown.map((c) => (
        <li>
          <span class="wrap">
            <strong>{c.workspaceName}</strong>
            <small class="muted">
              {" "}· as {ROLE_LABELS[c.role]}
              {c.invitedBy && <> · from {c.invitedBy}</>}
            </small>
          </span>
          {verified && (
            <span class="row-actions">
              <form method="post" action="/api/invite/accept" class="inline-form">
                <input type="hidden" name="id" value={c.id} />
                <button class="btn-sm" type="submit">Accept</button>
              </form>
              <form method="post" action="/api/invite/accept" class="inline-form">
                <input type="hidden" name="id" value={c.id} />
                <input type="hidden" name="action" value="decline" />
                <button class="btn-ghost btn-sm" type="submit">Decline</button>
              </form>
            </span>
          )}
        </li>
      ))}
    </ul>

    {remaining > 0 && (
      <a href="/workspaces">See the other {remaining}</a>
    )}
  </div>
)}
