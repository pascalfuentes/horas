---
/**
 * The brand mark: a sun-yellow stopwatch. The sky slice between the hands is
 * the time already tracked, and the hard shadow is the one the buttons have.
 * The outline and the shadow follow the theme (`--ink`); the hands stay dark,
 * because they sit on the yellow face in both themes.
 * The same drawing lives in public/favicon.svg and scripts/make-icons.py.
 */
---

<svg class="logo" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <circle class="logo-shadow" cx="16" cy="19" r="11.75"></circle>
  <rect class="logo-line" x="12.75" y="1.5" width="6.5" height="5" rx="1.5" fill="#fd976d" stroke-width="2"></rect>
  <circle class="logo-line" cx="16" cy="17" r="10.5" fill="#fdd46b" stroke-width="2.5"></circle>
  <path d="M16 17V7.75A9.25 9.25 0 0 1 24.01 21.63Z" fill="#5dcdf1"></path>
  <path d="M16 10.25V17l5.63 3.25" fill="none" stroke="#1b1624" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
