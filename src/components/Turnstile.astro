---
/**
 * Cloudflare Turnstile widget.
 *
 * Only renders when BOTH keys exist. If it showed up with just the sitekey,
 * the person would solve the challenge and the server would check nothing —
 * fake protection is worse than no protection, because it looks like it is
 * there.
 *
 * Without keys (the local development case), the widget disappears and
 * `verifyTurnstile` lets the request through. The two sides always agree.
 *
 * Rendering is EXPLICIT. Two details that cost a lot here:
 *
 * 1. `?onload=` alone is not enough — the script KEEPS doing its automatic
 *    scan for `.cf-turnstile` in addition to calling the callback. The two
 *    renders collided ("skipped implicit render because a widget already
 *    exists"), the challenge iframe never appeared and no token was
 *    generated. Since the server requires the token, logging in became
 *    impossible. `&render=explicit` turns the automatic scan off.
 *
 * 2. `onload` does not fire if the script has already loaded, hence the
 *    `window.turnstile` check — and `data-rendered` prevents rendering twice.
 */
const { PUBLIC_TURNSTILE_SITE_KEY: siteKey, TURNSTILE_SECRET_KEY: secret } = Astro.locals.env;
const enabled = Boolean(siteKey && secret);
---
{enabled && (
  <>
    <div class="cf-turnstile" data-sitekey={siteKey} style="margin-bottom:14px; min-height:65px"></div>

    <script is:inline>
      window.renderTurnstile = function () {
        document.querySelectorAll(".cf-turnstile").forEach(function (el) {
          if (el.dataset.rendered) return;
          el.dataset.rendered = "1";
          window.turnstile.render(el, { sitekey: el.dataset.sitekey, theme: "auto" });
        });
      };
      // If the script has already loaded, `onload` no longer fires.
      if (window.turnstile) window.renderTurnstile();
    </script>

    <script is:inline async defer
      src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=renderTurnstile"></script>
  </>
)}
