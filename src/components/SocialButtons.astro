---
import { socialProviders } from "~/lib/env";

interface Props {
  /** Where to return to after logging in. */
  next?: string;
  /** Button text: "Log in with" on login, "Create account with" on the invite. */
  verb?: string;
}

const { next = "/dashboard", verb = "Log in with" } = Astro.props;
const providers = socialProviders(Astro.locals.env);

const NAMES = { google: "Google", github: "GitHub" } as const;
---

{providers.length > 0 && (
  <>
    <div class="divider"><span>or</span></div>

    <div class="stack">
      {providers.map((p) => (
        <form method="post" action="/api/social">
          <input type="hidden" name="provider" value={p} />
          <input type="hidden" name="next" value={next} />
          <button class="btn-ghost btn-block" type="submit">{verb} {NAMES[p]}</button>
        </form>
      ))}
    </div>
  </>
)}
