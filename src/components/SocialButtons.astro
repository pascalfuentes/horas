---
import { socialProviders } from "~/lib/env";

interface Props {
  /** Para onde voltar depois de entrar. */
  next?: string;
  /** Texto dos botões: "Entrar com" no login, "Criar conta com" no convite. */
  verbo?: string;
}

const { next = "/dashboard", verbo = "Entrar com" } = Astro.props;
const provedores = socialProviders(Astro.locals.env);

const NOMES = { google: "Google", github: "GitHub" } as const;
---

{provedores.length > 0 && (
  <>
    <div class="divisor"><span>ou</span></div>

    <div class="stack">
      {provedores.map((p) => (
        <form method="post" action="/api/social">
          <input type="hidden" name="provider" value={p} />
          <input type="hidden" name="next" value={next} />
          <button class="btn-ghost btn-block" type="submit">{verbo} {NOMES[p]}</button>
        </form>
      ))}
    </div>
  </>
)}
