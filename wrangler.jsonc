// TEMPLATE version.
//
// The database_id is a recognizable placeholder. It has a valid format on
// purpose, so a clone can run locally (`npm run db:local && npm run dev`)
// without configuring anything. But `npm run db:remote` refuses while it is
// here, otherwise a new project's migrations would land in another project's
// production database without complaint.
//
// `npm run new-project` writes the real values to wrangler.local.jsonc, which
// stays out of Git and wins over this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "horas",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Public on purpose: the Turnstile sitekey is rendered in the HTML.
  // The matching secret key is a secret (`wrangler secret put`).
  // Empty = no Turnstile; the widget disappears and verification is skipped.
  "vars": {
    "OPERATOR_NAME": "",
    "OPERATOR_CONTACT": "",
    "PUBLIC_TURNSTILE_SITE_KEY": ""
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "horas_db",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ]

  // Secrets (NEVER in the repository: use `wrangler secret put <NAME>`):
  //   BETTER_AUTH_SECRET   openssl rand -base64 32
  //   BETTER_AUTH_URL      https://your-domain.com
  //   RESEND_API_KEY       optional: without it, e-mails go to the log
  //   EMAIL_FROM           "Name <no-reply@your-domain.com>"
  //   SETUP_SECRET         used a single time to create the first admin
  //   TURNSTILE_SECRET_KEY optional (the public sitekey lives in "vars" above)
}
